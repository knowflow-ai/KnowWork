+import { describe, expect, it } from 'vitest'
+import { appOfPage, menuShortcut } from '../src/web/shim/menu-shortcuts'
+
+const key = (
+  k: string,
+  mods: Partial<Record<'ctrlKey' | 'metaKey' | 'shiftKey' | 'altKey', boolean>> = {},
+) => ({
+  key: k,
+  ctrlKey: false,
+  metaKey: false,
+  shiftKey: false,
+  altKey: false,
+  ...mods,
+})
+
+describe('web-mode save shortcuts', () => {
+  it('sends the menu push the native accelerator would', () => {
+    expect(menuShortcut('sheets', key('s', { ctrlKey: true }))).toEqual({
+      channel: 'menu:action',
+      args: ['save'],
+    })
+    expect(menuShortcut('slides', key('S', { metaKey: true, shiftKey: true }))).toEqual({
+      channel: 'slides:menu',
+      args: ['save-as'],
+    })
+  })
+
+  it('leaves other keys and Docs alone', () => {
+    expect(menuShortcut('docs', key('s', { ctrlKey: true }))).toBeNull()
+    expect(menuShortcut('sheets', key('s'))).toBeNull()
+    expect(menuShortcut('sheets', key('s', { ctrlKey: true, altKey: true }))).toBeNull()
+    expect(menuShortcut('slides', key('p', { ctrlKey: true }))).toBeNull()
+  })
+
+  it('reads the app from the page path', () => {
+    expect(appOfPage('/sheets/')).toBe('sheets')
+    expect(appOfPage('/')).toBe('')
+  })
+})

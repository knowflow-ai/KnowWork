   })
+
+  it('sends binaries as raw bytes in a binary frame, not as base64 text', () => {
+    // base64 inside JSON made every file a third bigger on the wire and left both
+    // ends parsing strings of tens of MB
+    const data = new Uint8Array(1024 * 1024)
+    for (let i = 0; i < data.length; i += 997) data[i] = i % 256
+    const frame = encodeFrame({
+      t: 'invoke',
+      id: 1,
+      channel: 'docs:save',
+      args: ['/w/a.docx', data],
+    })
+    expect(frame).toBeInstanceOf(Uint8Array)
+    expect((frame as Uint8Array).byteLength).toBeLessThan(data.byteLength + 1024)
+    const out = decodeFrame(frame) as { args: [string, Uint8Array] }
+    expect(out.args[0]).toBe('/w/a.docx')
+    expect(out.args[1]).toBeInstanceOf(Uint8Array)
+    expect(Buffer.from(out.args[1]).equals(Buffer.from(data))).toBe(true)
+  })
+
+  it('keeps frames without binaries as text', () => {
+    expect(typeof encodeFrame({ t: 'reply', id: 2, ok: true, value: { a: [1, 'x'] } })).toBe(
+      'string',
+    )
+  })
+
+  it('carries several binaries, live view ranges and Buffers in one frame', () => {
+    const backing = new Uint8Array([10, 20, 30, 40, 50])
+    const frame = encodeFrame({
+      a: new Uint8Array([1, 2]).buffer,
+      nested: [{ view: backing.subarray(1, 4) }, Buffer.from([7, 8, 9])],
+      empty: new Uint8Array(0),
+    })
+    const out = decodeFrame(frame) as {
+      a: Uint8Array
+      nested: [{ view: Uint8Array }, Uint8Array]
+      empty: Uint8Array
+    }
+    expect([...out.a]).toEqual([1, 2])
+    expect([...out.nested[0].view]).toEqual([20, 30, 40])
+    expect(out.nested[1]).toBeInstanceOf(Uint8Array)
+    expect([...out.nested[1]]).toEqual([7, 8, 9])
+    expect(out.empty.byteLength).toBe(0)
+  })
+
+  it('decodes a binary frame as each end receives it', () => {
+    const frame = encodeFrame({ data: new Uint8Array([4, 5, 6]) }) as Uint8Array
+    // the browser asks for ArrayBuffer messages; Node's ws hands over a Buffer
+    const copy = frame.slice()
+    const fromBrowser = decodeFrame(copy.buffer) as { data: Uint8Array }
+    const fromNode = decodeFrame(Buffer.from(frame)) as { data: Uint8Array }
+    expect([...fromBrowser.data]).toEqual([4, 5, 6])
+    expect([...fromNode.data]).toEqual([4, 5, 6])
+  })
 })

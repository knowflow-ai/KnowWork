@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import { Outbox } from '../src/web/shim/outbox'
+
+// a page whose bundle comes from the browser cache boots faster than the bridge
+// socket connects: a frame sent while it was still connecting used to be
+// dropped, its invoke never answered, and the editor stayed blank
+function fakeSocket(readyState: number) {
+  const sent: (string | Uint8Array)[] = []
+  return { readyState, sent, send: (frame: string | Uint8Array) => sent.push(frame) }
+}
+
+describe('web bridge outbox', () => {
+  it('holds frames sent while the socket connects and sends them in order once open', () => {
+    const outbox = new Outbox()
+    const socket = fakeSocket(0)
+    outbox.send(socket, 'first')
+    outbox.send(socket, new Uint8Array([1, 2]))
+    expect(socket.sent).toEqual([])
+    socket.readyState = 1
+    outbox.flush(socket)
+    outbox.send(socket, 'third')
+    expect(socket.sent).toEqual(['first', new Uint8Array([1, 2]), 'third'])
+  })
+
+  it('sends right away on an open socket', () => {
+    const socket = fakeSocket(1)
+    new Outbox().send(socket, 'now')
+    expect(socket.sent).toEqual(['now'])
+  })
+
+  it('drops what waited for a socket that closed before opening', () => {
+    const outbox = new Outbox()
+    const closing = fakeSocket(0)
+    outbox.send(closing, 'lost')
+    outbox.drop()
+    const next = fakeSocket(1)
+    outbox.flush(next)
+    outbox.send(fakeSocket(3), 'closed')
+    expect(next.sent).toEqual([])
+  })
+})

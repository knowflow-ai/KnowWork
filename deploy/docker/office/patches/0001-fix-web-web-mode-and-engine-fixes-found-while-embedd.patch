--- /dev/null
+++ b/apps/docs/src/renderer/components/page-confirm.ts
@@ -0,0 +1,61 @@
+import { t } from '../i18n/locale'
+import './page-confirm.css'
+
+/**
+ * An OK/Cancel question (or an OK-only notice) in the editor's own modal style.
+ * window.confirm / window.alert open the browser's or Electron's native box,
+ * whose buttons are fixed English "OK"/"Cancel" in Electron and not the editor's
+ * language; inside an embedding page they also block every frame. Plain DOM so
+ * any caller (React or not, e.g. the Zotero controller) can await it.
+ */
+export function askInPage(message: string, options: { cancel?: boolean } = {}): Promise<boolean> {
+  const withCancel = options.cancel !== false
+  return new Promise((resolve) => {
+    const backdrop = document.createElement('div')
+    backdrop.className = 'modal-backdrop'
+    const box = document.createElement('div')
+    box.className = 'modal gs-form page-confirm'
+    box.setAttribute('role', withCancel ? 'alertdialog' : 'dialog')
+    box.setAttribute('aria-modal', 'true')
+    const text = document.createElement('p')
+    text.className = 'page-confirm-message'
+    text.textContent = message
+    const actions = document.createElement('div')
+    actions.className = 'modal-actions'
+    const button = (label: string, primary: boolean): HTMLButtonElement => {
+      const element = document.createElement('button')
+      element.type = 'button'
+      element.textContent = label
+      if (primary) element.className = 'primary'
+      return element
+    }
+    const ok = button(t('appOk'), true)
+    const cancel = withCancel ? button(t('appCancel'), false) : null
+    const done = (answer: boolean): void => {
+      document.removeEventListener('keydown', onKey, true)
+      backdrop.remove()
+      resolve(answer)
+    }
+    const onKey = (event: KeyboardEvent): void => {
+      if (event.key === 'Escape') {
+        event.preventDefault()
+        done(false)
+      } else if (event.key === 'Enter') {
+        event.preventDefault()
+        done(true)
+      }
+    }
+    ok.addEventListener('click', () => done(true))
+    cancel?.addEventListener('click', () => done(false))
+    backdrop.addEventListener('mousedown', (event) => {
+      if (event.target === backdrop) done(false)
+    })
+    if (cancel) actions.append(cancel)
+    actions.append(ok)
+    box.append(text, actions)
+    backdrop.append(box)
+    document.body.append(backdrop)
+    document.addEventListener('keydown', onKey, true)
+    ok.focus()
+  })
+}

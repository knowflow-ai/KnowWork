@@ -0,0 +1,59 @@
+/**
+ * Save shortcuts for the editors whose Save lives on the native menu.
+ *
+ * Sheets and Slides bind Ctrl/Cmd+S (Shift for Save As) as accelerators of the
+ * Electron application menu. A browser tab has no such menu, so in web-server
+ * mode the keys did nothing there and only the toolbar button saved (Docs
+ * handles the keys in its own renderer and needs nothing). This maps the keys
+ * to the same push the menu item sends to the editor.
+ */
+
+export interface MenuPush {
+  channel: string
+  args: unknown[]
+}
+
+export interface ShortcutKey {
+  key: string
+  ctrlKey: boolean
+  metaKey: boolean
+  shiftKey: boolean
+  altKey: boolean
+}
+
+/** menu channel per app; the strings are the ones the menus send (sheets IPC_CHANNELS.menuAction, slides 'slides:menu') */
+const MENU_CHANNEL: Record<string, string> = {
+  sheets: 'menu:action',
+  slides: 'slides:menu',
+}
+
+/** the menu push for this key press in this app, or null to leave the key alone */
+export function menuShortcut(app: string, key: ShortcutKey): MenuPush | null {
+  const channel = MENU_CHANNEL[app]
+  if (!channel) return null
+  if (key.altKey || !(key.ctrlKey || key.metaKey)) return null
+  if (key.key.toLowerCase() !== 's') return null
+  return { channel, args: [key.shiftKey ? 'save-as' : 'save'] }
+}
+
+/** the app a web-mode page belongs to: /<app>/?path=… */
+export function appOfPage(pathname: string): string {
+  return pathname.split('/')[1] ?? ''
+}
+
+/** Ctrl/Cmd+S in the editors whose Save is a native-menu accelerator (menu-shortcuts.ts) */
+export function installMenuShortcuts(): void {
+  const app = appOfPage(window.location.pathname)
+  window.addEventListener(
+    'keydown',
+    (ev) => {
+      const push = menuShortcut(app, ev)
+      if (!push) return
+      ev.preventDefault()
+      const dispatch = (window as unknown as Record<string, unknown>).__genofficeWebDispatch as
+        ((channel: string, args: unknown[]) => void) | undefined
+      dispatch?.(push.channel, push.args)
+    },
+    true,
+  )
+}
diff --git a/apps/shell/src/web/shim/outbox.ts b/apps/shell/src/web/shim/outbox.ts
new file mode 100644
index 00000000..df7a663d
--- /dev/null
+++ b/apps/shell/src/web/shim/outbox.ts
@@ -0,0 +1,39 @@
+/**
+ * Frames the page sends before its bridge socket has opened. A page whose
+ * bundle comes from the browser cache boots faster than the socket connects;
+ * a frame sent while it was still connecting used to be dropped, its invoke
+ * was never answered and the editor stayed blank. Frames wait here and go out
+ * in order once the socket opens; a socket that closes first drops them (their
+ * invokes fail with the close, as before).
+ */
+
+export interface OutboxSocket {
+  readonly readyState: number
+  send(data: string | Uint8Array): void
+}
+
+// WebSocket.CONNECTING / OPEN, spelled out so the module also loads where the
+// WebSocket global is absent (tests)
+const CONNECTING = 0
+const OPEN = 1
+
+export class Outbox {
+  private waiting: (string | Uint8Array)[] = []
+
+  send(socket: OutboxSocket | null, frame: string | Uint8Array): void {
+    if (!socket) return
+    if (socket.readyState === OPEN) socket.send(frame)
+    else if (socket.readyState === CONNECTING) this.waiting = [...this.waiting, frame]
+  }
+
+  /** the socket just opened: send what waited for it */
+  flush(socket: OutboxSocket): void {
+    const waiting = this.waiting
+    this.waiting = []
+    for (const frame of waiting) socket.send(frame)
+  }
+
+  drop(): void {
+    this.waiting = []
+  }
+}

+/**
+ * Revalidation for renderer files served in web mode (static.ts). Text bundles
+ * are rewritten on the way out (scheme → same-origin path), so what is sent is
+ * not fixed by the hashed file name alone — a newer shell may rewrite the same
+ * file differently — and they went out no-store: every open of the editor
+ * fetched the whole bundle again (21 MB for sheets) and re-read and re-rewrote
+ * it. Each file now gets an ETag from what decides its output (path, size,
+ * mtime, the app's rewrite rules) without reading it, and a request carrying
+ * that ETag is answered 304.
+ */
+import { createHash } from 'node:crypto'
+import { statSync } from 'node:fs'
+
+/** the ETag of a renderer file as served with these rewrite rules */
+export function assetEtag(file: string, rules: unknown): string {
+  const stat = statSync(file)
+  const basis = JSON.stringify([file, stat.size, stat.mtimeMs, rules ?? null])
+  return `"${createHash('sha256').update(basis).digest('base64url').slice(0, 32)}"`
+}
+
+/** whether an If-None-Match header names this ETag (weak or strong), or is * */
+export function stillFresh(header: string | string[] | undefined, etag: string): boolean {
+  const value = Array.isArray(header) ? header.join(',') : (header ?? '')
+  return value.split(',').some((raw) => {
+    const tag = raw.trim()
+    return tag === '*' || tag.replace(/^W\//, '') === etag
+  })
+}

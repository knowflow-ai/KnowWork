new file mode 100644
index 00000000..6c555edd
--- /dev/null
+++ b/apps/shell/src/web/shim/dialog-answer.ts
@@ -0,0 +1,34 @@
+/**
+ * What a browser dialog overlay sends back when the user acts on it. The main
+ * process holds the Electron dialog call open (web-dialogs.ts serveWebDialog)
+ * until a `dialog-response` frame with the request's id arrives from the tab
+ * the dialog was served to; an overlay that only closes itself leaves that
+ * call — and whatever awaited it, e.g. opening a document behind the
+ * "recovered version found" prompt — pending until the tab disconnects.
+ */
+
+export type DialogAnswer =
+  { kind: 'message'; response: number } | { kind: 'file'; path: string | null }
+
+export type DialogResponseFrame = {
+  t: 'dialog-response'
+  id: number
+  result:
+    | { canceled: true }
+    | { canceled: false; response: number }
+    | { canceled: false; filePath: string; filePaths: string[] }
+}
+
+export function dialogResponseFrame(id: number, answer: DialogAnswer): DialogResponseFrame {
+  if (answer.kind === 'message') {
+    return { t: 'dialog-response', id, result: { canceled: false, response: answer.response } }
+  }
+  return {
+    t: 'dialog-response',
+    id,
+    result:
+      answer.path === null
+        ? { canceled: true }
+        : { canceled: false, filePath: answer.path, filePaths: [answer.path] },
+  }
+}

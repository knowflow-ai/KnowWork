diff --git a/packages/pptx-engine/tests/save-streaming.test.ts b/packages/pptx-engine/tests/save-streaming.test.ts
index 02785660..b341bf5a 100644
--- a/packages/pptx-engine/tests/save-streaming.test.ts
+++ b/packages/pptx-engine/tests/save-streaming.test.ts
@@ -156,4 +156,28 @@ describe('savePptxToFile error containment', () => {
     }
     expect(uncaught).toBeNull()
   })
+
+  it('writes sizes up front and no folder entries, so LibreOffice can read it', async () => {
+    const opened = await openPptx(fx('01_standard_business.pptx'))
+    const target = out()
+    await savePptxToFile(opened, target)
+
+    // walk the local file headers: general-purpose flag bit 3 means the sizes
+    // follow the data (a data descriptor), which a STORED entry must not use
+    const bytes = readFileSync(target)
+    const names: string[] = []
+    let offset = 0
+    while (bytes.readUInt32LE(offset) === 0x04034b50) {
+      const flags = bytes.readUInt16LE(offset + 6)
+      const compressedSize = bytes.readUInt32LE(offset + 18)
+      const nameLength = bytes.readUInt16LE(offset + 26)
+      const extraLength = bytes.readUInt16LE(offset + 28)
+      const name = bytes.toString('utf8', offset + 30, offset + 30 + nameLength)
+      names.push(name)
+      expect(flags & 0x0008, `${name} has a data descriptor`).toBe(0)
+      offset += 30 + nameLength + extraLength + compressedSize
+    }
+    expect(names.length).toBeGreaterThan(0)
+    expect(names.filter((name) => name.endsWith('/'))).toEqual([])
+  })
 })

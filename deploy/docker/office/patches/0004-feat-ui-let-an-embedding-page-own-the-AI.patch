+import { describe, expect, it } from 'vitest'
+import { busyOf, slidesAiEditMessage } from '../src/renderer/host-bridge'
+
+describe('slides host bridge (an embedding page owns the AI)', () => {
+  it('hands the page, the selected elements and their text over', () => {
+    expect(
+      slidesAiEditMessage('换个更有力的标题', true, {
+        slide: 0,
+        targets: [
+          { id: 'e_2', type: 'text', text: '三季度经营汇报' },
+          { id: 'e_5', type: 'image' },
+        ],
+      }),
+    ).toEqual({
+      type: 'genoffice:ai-edit',
+      instruction: '换个更有力的标题',
+      send: true,
+      selection: {
+        isRange: true,
+        text: '三季度经营汇报',
+        slide: 0,
+        elements: [
+          { id: 'e_2', type: 'text' },
+          { id: 'e_5', type: 'image' },
+        ],
+      },
+    })
+  })
+
+  it('without a selection only the page goes, queued edits are not sent', () => {
+    const message = slidesAiEditMessage('逐页检查错别字', false, { slide: 2, targets: [] })
+    expect(message.send).toBe(false)
+    expect(message.selection).toEqual({ isRange: false, text: '', slide: 2, elements: [] })
+  })
+
+  it('reads the host busy mark: page and element ids; no elements clears it', () => {
+    expect(busyOf({ slide: { index: 1, elements: ['e_5', '', 3] }, label: 'AI 正在改' })).toEqual({
+      slide: 1,
+      elements: ['e_5'],
+      label: 'AI 正在改',
+    })
+    expect(busyOf({ slide: { index: 1, elements: [] } })).toBeNull()
+    expect(busyOf({})).toBeNull()
+  })
+})

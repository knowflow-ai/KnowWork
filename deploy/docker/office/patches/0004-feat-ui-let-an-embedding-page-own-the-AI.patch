@@ -0,0 +1,88 @@
+/**
+ * Every start of the built-in assistant sets App's preset; when a host page
+ * owns the AI the wrapped setter hands the request (with the selection) to the
+ * host instead, and the selection's "add to queue" goes to the host's composer.
+ */
+import { act, createElement } from 'react'
+import { createRoot } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { Editor } from '@tiptap/core'
+import { TextSelection } from '@tiptap/pm/state'
+import { editorExtensions } from '../src/renderer/editor/extensions'
+
+let mockOrigin: string | null = null
+vi.mock('@genoffice/ui', async (original) => ({
+  ...(await original<typeof import('@genoffice/ui')>()),
+  hostAiOrigin: () => mockOrigin,
+}))
+
+import { useHostOwnedAi } from '../src/renderer/host-bridge'
+
+type Preset = { text: string; nonce: number; autoRun?: boolean } | null
+
+function editorWith(text: string): Editor {
+  const editor = new Editor({
+    element: document.createElement('div'),
+    extensions: editorExtensions,
+    content: {
+      type: 'doc',
+      content: [{ type: 'docParagraph', content: [{ type: 'text', text }] }],
+    },
+  })
+  editor.view.dispatch(editor.state.tr.setSelection(TextSelection.create(editor.state.doc, 1, 3)))
+  return editor
+}
+
+function mount(raw: (next: unknown) => void): ReturnType<typeof useHostOwnedAi<Preset>> {
+  let hook: ReturnType<typeof useHostOwnedAi<Preset>> | undefined
+  function Probe() {
+    hook = useHostOwnedAi<Preset>(raw as never)
+    return null
+  }
+  const root = createRoot(document.createElement('div'))
+  act(() => root.render(createElement(Probe)))
+  return hook!
+}
+
+beforeEach(() => vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true))
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+  mockOrigin = null
+})
+
+describe('useHostOwnedAi', () => {
+  it('a host that owns the AI gets the panel request, with the selection; the panel does not start', () => {
+    mockOrigin = 'https://kw.example'
+    const raw = vi.fn()
+    const posted = vi.spyOn(window.parent, 'postMessage').mockImplementation(() => undefined)
+    const hook = mount(raw)
+    const editor = editorWith('举头望明月')
+    hook.editorRef.current = editor
+    hook.setPreset({ text: '校对全文', nonce: 1, autoRun: true })
+    expect(raw).not.toHaveBeenCalled()
+    expect(posted).toHaveBeenCalledWith(
+      expect.objectContaining({ type: 'genoffice:ai-edit', instruction: '校对全文', send: true }),
+      'https://kw.example',
+    )
+    // clearing the preset still reaches the panel state
+    hook.setPreset(null)
+    expect(raw).toHaveBeenCalledWith(null)
+    expect(hook.queue('改简洁')).toBe(true)
+    expect(posted).toHaveBeenLastCalledWith(
+      expect.objectContaining({ instruction: '改简洁', send: false }),
+      'https://kw.example',
+    )
+    editor.destroy()
+  })
+
+  it('without a host the built-in panel works as before', () => {
+    const raw = vi.fn()
+    const hook = mount(raw)
+    hook.editorRef.current = editorWith('x')
+    const preset = { text: '校对全文', nonce: 1, autoRun: true }
+    hook.setPreset(preset)
+    expect(raw).toHaveBeenCalledWith(preset)
+    expect(hook.queue('改简洁')).toBe(false)
+  })
+})

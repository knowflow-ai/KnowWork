@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest'
+import { framesOf, type BlockBox } from '../src/renderer/editor/ai-busy-frame'
+
+/**
+ * The blocks an embedding host's agent works on get one dashed frame per run,
+ * not one per block: a run ends where a page gap or a column break falls
+ * between two blocks, so a range over a page boundary gets a frame per page.
+ */
+
+const block = (
+  top: number,
+  bottom: number,
+  left = 100,
+  right = 700,
+  breakBefore = false,
+): BlockBox => ({
+  top,
+  bottom,
+  left,
+  right,
+  breakBefore,
+})
+
+describe('busy frames', () => {
+  it('draws one frame around adjacent blocks, across the spacing between them', () => {
+    const frames = framesOf([block(100, 130), block(142, 170, 124), block(182, 210, 100, 720)])
+    expect(frames).toEqual([{ top: 96, left: 96, right: 724, bottom: 214 }])
+  })
+
+  it('starts a new frame after a page gap', () => {
+    const frames = framesOf([block(100, 130), block(142, 170), block(1300, 1330, 100, 700, true)])
+    expect(frames).toEqual([
+      { top: 96, left: 96, right: 704, bottom: 174 },
+      { top: 1296, left: 96, right: 704, bottom: 1334 },
+    ])
+  })
+
+  it('starts a new frame when the next block moves up into another column', () => {
+    const frames = framesOf([block(900, 960, 100, 380), block(100, 140, 420, 700)])
+    expect(frames).toHaveLength(2)
+  })
+
+  it('has nothing to frame without blocks', () => {
+    expect(framesOf([])).toEqual([])
+  })
+})
diff --git a/apps/docs/tests/host-bridge.test.ts b/apps/docs/tests/host-bridge.test.ts
new file mode 100644
index 00000000..7851cfb1
--- /dev/null
+++ b/apps/docs/tests/host-bridge.test.ts
@@ -0,0 +1,150 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Editor } from '@tiptap/core'
+import { TextSelection } from '@tiptap/pm/state'
+import { editorExtensions } from '../src/renderer/editor/extensions'
+import { aiBusyRanges, sanitizeAiBusyRanges } from '../src/renderer/editor/ai-busy'
+import { hostOrigin, installHostBridge, postAiEdit } from '../src/renderer/host-bridge'
+
+/**
+ * The editor embedded in a host page that owns the AI: selection + instruction
+ * go up to the host, and the host scrolls to blocks and marks the ones its
+ * agent is working on. Only the named host origin, framing the editor, is heard.
+ */
+
+const HOST = 'https://kw.example'
+const para = (value: string) => ({
+  type: 'docParagraph',
+  attrs: { docxIndex: null },
+  content: [{ type: 'text', text: value }],
+})
+
+const liveEditors: Editor[] = []
+function createEditor(texts: string[]): Editor {
+  const editor = new Editor({
+    element: document.createElement('div'),
+    extensions: editorExtensions,
+    content: { type: 'doc', content: texts.map(para) },
+  })
+  liveEditors.push(editor)
+  return editor
+}
+afterEach(() => {
+  for (const editor of liveEditors.splice(0)) editor.destroy()
+})
+
+type Listener = (event: MessageEvent) => void
+function fakeWindow(search: string, ancestors?: string[]) {
+  const parent = { postMessage: vi.fn() }
+  const listeners: Listener[] = []
+  const win = {
+    parent,
+    location: { search, ...(ancestors ? { ancestorOrigins: ancestors } : {}) },
+    addEventListener: (_: string, fn: Listener) => listeners.push(fn),
+    removeEventListener: (_: string, fn: Listener) => listeners.splice(listeners.indexOf(fn), 1),
+  }
+  const deliver = (data: unknown, source: unknown = parent, origin = HOST) => {
+    for (const fn of [...listeners]) fn({ data, source, origin } as MessageEvent)
+  }
+  return { win: win as unknown as Window, parent, listeners, deliver }
+}
+
+describe('host origin', () => {
+  it('needs a frame, a host parameter and a matching framing origin', () => {
+    expect(hostOrigin(fakeWindow(`?host=${HOST}/chat`).win)).toBe(HOST)
+    expect(hostOrigin(fakeWindow(`?host=${HOST}`, [HOST]).win)).toBe(HOST)
+    expect(hostOrigin(fakeWindow(`?host=${HOST}`, ['https://evil.example']).win)).toBeNull()
+    expect(hostOrigin(fakeWindow('?path=/x.docx').win)).toBeNull()
+    expect(hostOrigin(fakeWindow('?host=not a url').win)).toBeNull()
+    const top = fakeWindow(`?host=${HOST}`)
+    ;(top.win as unknown as { parent: unknown }).parent = top.win
+    expect(hostOrigin(top.win)).toBeNull()
+  })
+})
+
+describe('host bridge', () => {
+  it('hands the selection and instruction to the host', () => {
+    const editor = createEditor(['First paragraph', 'Second paragraph', 'Third'])
+    const second = editor.state.doc.child(0).nodeSize
+    editor.view.dispatch(
+      editor.state.tr.setSelection(TextSelection.create(editor.state.doc, second + 1, second + 7)),
+    )
+    const { win, parent } = fakeWindow(`?host=${HOST}`)
+    postAiEdit(editor, HOST, 'make it a table', false, win)
+    expect(parent.postMessage).toHaveBeenCalledWith(
+      {
+        type: 'genoffice:ai-edit',
+        instruction: 'make it a table',
+        send: false,
+        selection: { startBlockIndex: 1, endBlockIndex: 1, isRange: true, text: 'Second' },
+      },
+      HOST,
+    )
+  })
+
+  it('marks and clears the blocks the agent is working on', () => {
+    const editor = createEditor(['One', 'Two', 'Three'])
+    const { win, parent, deliver } = fakeWindow(`?host=${HOST}`)
+    const uninstall = installHostBridge(() => editor, HOST, win)
+    expect(parent.postMessage).toHaveBeenCalledWith({ type: 'genoffice:ready' }, HOST)
+
+    // jsdom lays nothing out: stack the blocks 30px apart, 20px high
+    vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockImplementation(function (
+      this: HTMLElement,
+    ) {
+      const index = this.parentElement ? Array.from(this.parentElement.children).indexOf(this) : 0
+      return DOMRect.fromRect({ x: 100, y: 100 + index * 30, width: 600, height: 20 })
+    })
+    deliver({ type: 'genoffice:ai-busy', ranges: [{ start: 1, end: 2, label: 'AI is rewriting' }] })
+    expect(aiBusyRanges(editor.state)).toEqual([{ start: 1, end: 2, label: 'AI is rewriting' }])
+    // one frame around both blocks (130..180, 4px out), laid over the editor
+    const shown = () =>
+      document.querySelectorAll<HTMLElement>('.ai-busy-layer .ai-busy-frame:not([hidden])')
+    expect(shown()).toHaveLength(1)
+    expect(shown()[0]!.textContent).toBe('AI is rewriting')
+    expect(shown()[0]!.style.top).toBe('126px')
+    expect(shown()[0]!.style.height).toBe('58px')
+    // laid over, not written in: the document did not change
+    expect(editor.state.doc.textContent).toBe('OneTwoThree')
+
+    deliver({ type: 'genoffice:ai-busy', ranges: [] })
+    expect(shown()).toHaveLength(0)
+    uninstall()
+    expect(document.querySelector('.ai-busy-layer')).toBeNull()
+    vi.restoreAllMocks()
+  })
+
+  it('scrolls to a block on request', () => {
+    const editor = createEditor(['One', 'Two', 'Three'])
+    const { win, deliver } = fakeWindow(`?host=${HOST}`)
+    const uninstall = installHostBridge(() => editor, HOST, win)
+    deliver({ type: 'genoffice:reveal-block', index: 2 })
+    expect(editor.state.selection.$from.parent.textContent).toBe('Three')
+    uninstall()
+  })
+
+  it('ignores other windows and origins', () => {
+    const editor = createEditor(['One', 'Two'])
+    const { win, deliver } = fakeWindow(`?host=${HOST}`)
+    const uninstall = installHostBridge(() => editor, HOST, win)
+    const mark = { type: 'genoffice:ai-busy', ranges: [{ start: 0, end: 1 }] }
+    deliver(mark, {}, HOST)

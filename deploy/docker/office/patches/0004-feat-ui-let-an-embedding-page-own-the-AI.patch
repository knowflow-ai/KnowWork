+// @vitest-environment jsdom
+import { afterEach, describe, expect, it } from 'vitest'
+import { textSelection } from '../src/renderer/host-text-ask'
+
+function select(node: Node, start: number, end: number): void {
+  const range = document.createRange()
+  range.setStart(node, start)
+  range.setEnd(node, end)
+  // jsdom has no layout: a fixed box stands in for the selection's rect
+  range.getBoundingClientRect = () => ({ left: 10, top: 20, right: 110, bottom: 40 }) as DOMRect
+  const selection = document.getSelection()!
+  selection.removeAllRanges()
+  selection.addRange(range)
+}
+
+afterEach(() => {
+  document.getSelection()?.removeAllRanges()
+  document.body.innerHTML = ''
+})
+
+describe('words selected in a slide text box (host-owned Ask AI)', () => {
+  it('gives the selected words and where they sit', () => {
+    document.body.innerHTML =
+      '<div class="stage-wrap"><div class="slide-text-editor" contenteditable="true"><p>中国微短剧市场规模突破 500 亿元</p></div></div>'
+    const text = document.querySelector('.slide-text-editor p')!.firstChild!
+    select(text, 0, 9)
+    const selection = textSelection()
+    expect(selection?.text).toBe('中国微短剧市场规模')
+    expect(selection?.rect).toMatchObject({ left: 10, top: 20, right: 110, bottom: 40 })
+  })
+
+  it('nothing for a caret, blank text, or a selection outside a text box', () => {
+    document.body.innerHTML =
+      '<div class="slide-text-editor" contenteditable="true"><p>标题</p><p>   </p></div><p id="notes">备注</p>'
+    const [title, blank] = [...document.querySelectorAll('.slide-text-editor p')].map((p) => p.firstChild!)
+    select(title!, 1, 1)
+    expect(textSelection()).toBeNull()
+    select(blank!, 0, 3)
+    expect(textSelection()).toBeNull()
+    select(document.getElementById('notes')!.firstChild!, 0, 2)
+    expect(textSelection()).toBeNull()
+  })
+})

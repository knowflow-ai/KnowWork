new file mode 100644
index 00000000..c35ef2ba
--- /dev/null
+++ b/apps/slides/src/renderer/host-text-ask.tsx
@@ -0,0 +1,106 @@
+import { useCallback, useEffect, useState } from 'react'
+import {
+  AiAskPopover,
+  AiAskTrigger,
+  type AnchorRect,
+  type AskTarget,
+} from './components/AiAskPopover'
+import type { SlidesHostSelection } from './host-bridge'
+
+/**
+ * "Ask AI" on text selected while editing a text box, for an embedding page
+ * that owns the AI (host-bridge.ts). The built-in assistant only offers Ask AI
+ * on whole selected elements, hiding it while a text box is being edited; a
+ * host's user selects words the way they do in a document and expects the
+ * same bubble. It reuses the element Ask AI trigger and popover, and hands the
+ * request over with the page, the element's durable id and the selected words.
+ *
+ * The request is captured when the popover opens: typing in it moves focus
+ * out of the text box, which may end the edit.
+ */
+
+const TEXT_MAX = 4000
+
+interface TextSelection {
+  readonly text: string
+  readonly rect: AnchorRect
+}
+
+/** the words selected inside the slide's text editor, and where they sit on screen */
+export function textSelection(doc: Document = document): TextSelection | null {
+  const selection = doc.getSelection()
+  if (!selection || selection.isCollapsed || selection.rangeCount === 0) return null
+  const range = selection.getRangeAt(0)
+  const container = range.commonAncestorContainer
+  const element = container instanceof Element ? container : container.parentElement
+  if (!element?.closest('.slide-text-editor')) return null
+  const text = selection.toString().trim()
+  if (!text) return null
+  const box = range.getBoundingClientRect()
+  const stage = doc.querySelector('.stage-wrap')?.getBoundingClientRect()
+  return {
+    text: text.slice(0, TEXT_MAX),
+    rect: {
+      left: box.left,
+      top: box.top,
+      right: box.right,
+      bottom: box.bottom,
+      viewTop: stage?.top ?? 0,
+      viewBottom: stage?.bottom ?? doc.defaultView?.innerHeight ?? box.bottom,
+    },
+  }
+}
+
+export function HostTextAsk({
+  slide,
+  target,
+  ask,
+}: {
+  /** 0-based page index */
+  readonly slide: number
+  /** the element whose text is being edited; null when none can take the request */
+  readonly target: () => AskTarget | null
+  readonly ask: (instruction: string, send: boolean, selection: SlidesHostSelection) => void
+}): React.JSX.Element | null {
+  const [live, setLive] = useState<TextSelection | null>(null)
+  const [asking, setAsking] = useState<(TextSelection & { target: AskTarget }) | null>(null)
+
+  useEffect(() => {
+    const update = (): void => setLive(textSelection())
+    document.addEventListener('selectionchange', update)
+    return () => document.removeEventListener('selectionchange', update)
+  }, [])
+
+  const triggerRect = useCallback(() => live?.rect ?? null, [live])
+  const askRect = useCallback(() => asking?.rect ?? null, [asking])
+
+  if (asking) {
+    const finish = (instruction: string, send: boolean): void => {
+      setAsking(null)
+      ask(instruction, send, {
+        slide,
+        targets: [{ id: asking.target.id, type: asking.target.desc.type, text: asking.text }],
+      })
+    }
+    return (
+      <AiAskPopover
+        targets={[{ ...asking.target, desc: { ...asking.target.desc, text: asking.text } }]}
+        getAnchorRect={askRect}
+        queueFull={false}
+        onSubmit={(instruction) => finish(instruction, false)}
+        onSendNow={(instruction) => finish(instruction, true)}
+        onCancel={() => setAsking(null)}
+      />
+    )
+  }
+  if (!live || !target()) return null
+  return (
+    <AiAskTrigger
+      getAnchorRect={triggerRect}
+      onOpen={() => {
+        const element = target()
+        if (element) setAsking({ ...live, target: element })
+      }}
+    />
+  )
+}

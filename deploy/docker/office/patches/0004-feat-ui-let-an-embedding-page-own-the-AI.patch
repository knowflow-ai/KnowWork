diff --git a/apps/slides/src/renderer/host-bridge.ts b/apps/slides/src/renderer/host-bridge.ts
new file mode 100644
index 00000000..7b7ea17a
--- /dev/null
+++ b/apps/slides/src/renderer/host-bridge.ts
@@ -0,0 +1,133 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
+import { hostAiOrigin } from '@genoffice/ui'
+
+/**
+ * Host page bridge for the presentation: the editor embedded in another page's
+ * iframe (web-server mode), with that page owning the AI (see the docs app's
+ * host-bridge.ts for the protocol).
+ *
+ * Every request meant for the built-in assistant — the selection's "Ask AI"
+ * (send now, or add to queue), the ribbon's proofing and translate, the
+ * context menu's AI items — goes to the host (`genoffice:ai-edit`) with the
+ * page and the selected elements' durable ids (the ids read_deck and
+ * apply_slide_ops use), instead of the built-in panel.
+ *
+ * The host marks the elements its agent is working on (`genoffice:ai-busy`
+ * with `slide: { index, elements }` and a `label`; anything else clears it),
+ * drawn by host-busy.tsx.
+ *
+ * Off unless the editor URL names the host origin (`?host=<origin>`) and the
+ * editor really is framed by that origin.
+ */
+
+const TEXT_MAX = 4000
+
+/** the host's busy mark: page, durable element ids, label */
+export interface SlidesBusy {
+  readonly slide: number
+  readonly elements: readonly string[]
+  readonly label: string
+}
+
+/** the busy mark of a `genoffice:ai-busy` message, or null when it clears or is malformed */
+export function busyOf(data: { slide?: unknown; label?: unknown }): SlidesBusy | null {
+  const slide = data.slide as { index?: unknown; elements?: unknown } | undefined
+  if (!slide || !Number.isInteger(slide.index) || (slide.index as number) < 0) return null
+  const elements = Array.isArray(slide.elements)
+    ? slide.elements.filter((id): id is string => typeof id === 'string' && id !== '')
+    : []
+  if (elements.length === 0) return null
+  const label = typeof data.label === 'string' && data.label ? data.label.slice(0, 40) : 'AI'
+  return { slide: slide.index as number, elements, label }
+}
+
+export interface SlidesHostTarget {
+  /** durable element id */
+  id: string
+  type: string
+  text?: string
+}
+
+export interface SlidesHostSelection {
+  /** 0-based page index */
+  slide: number
+  targets: readonly SlidesHostTarget[]
+}
+
+export interface SlidesAiEditMessage {
+  type: 'genoffice:ai-edit'
+  instruction: string
+  /** true: run now; false: add to the host's pending edits */
+  send: boolean
+  selection: {
+    isRange: boolean
+    text: string
+    slide: number
+    elements: { id: string; type: string }[]
+  }
+}
+
+export function slidesAiEditMessage(
+  instruction: string,
+  send: boolean,
+  selection: SlidesHostSelection,
+): SlidesAiEditMessage {
+  const text = selection.targets
+    .map((target) => target.text?.trim() ?? '')
+    .filter(Boolean)
+    .join('\n')
+    .slice(0, TEXT_MAX)
+  return {
+    type: 'genoffice:ai-edit',
+    instruction,
+    send,
+    selection: {
+      isRange: selection.targets.length > 0,
+      text,
+      slide: selection.slide,
+      elements: selection.targets.map((target) => ({ id: target.id, type: target.type })),
+    },
+  }
+}
+
+/**
+ * When the embedding host owns the AI, `ask` hands a request to it with the
+ * current page and selection (from `selection`, read at call time) and returns
+ * true; otherwise it returns false and the caller runs the built-in assistant.
+ */
+export function useSlidesHostAi(selection: () => SlidesHostSelection): {
+  /** true when an embedding page owns the AI */
+  readonly owned: boolean
+  /** the elements the host's agent is working on, if any */
+  readonly busy: SlidesBusy | null
+  /** hand a request over (with `chosen`, else the current page and selection); false when no host owns the AI */
+  readonly ask: (instruction: string, send: boolean, chosen?: SlidesHostSelection) => boolean
+} {
+  const origin = useMemo(() => hostAiOrigin(), [])
+  const selectionRef = useRef(selection)
+  selectionRef.current = selection
+  const [busy, setBusy] = useState<SlidesBusy | null>(null)
+  useEffect(() => {
+    if (!origin) return
+    const onMessage = (event: MessageEvent): void => {
+      if (event.source !== window.parent || event.origin !== origin) return
+      const data = event.data as { type?: unknown; slide?: unknown; label?: unknown } | null
+      if (data?.type === 'genoffice:ai-busy') setBusy(busyOf(data))
+    }
+    window.addEventListener('message', onMessage)
+    window.parent.postMessage({ type: 'genoffice:ready' }, origin)
+    return () => window.removeEventListener('message', onMessage)
+  }, [origin])
+  const ask = useCallback(
+    (instruction: string, send: boolean, chosen?: SlidesHostSelection) => {
+      if (!origin) return false
+      window.parent.postMessage(
+        slidesAiEditMessage(instruction, send, chosen ?? selectionRef.current()),
+        origin,
+      )
+      return true
+    },
+    [origin],
+  )
+  return useMemo(() => ({ owned: origin !== null, busy, ask }), [origin, busy, ask])
+}

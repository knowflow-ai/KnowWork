@@ -0,0 +1,76 @@
+/* an embedding host's agent is about to rewrite these blocks (editor/ai-busy.ts):
+   one frame per run, laid over the editor by ai-busy-frame.ts, so pagination
+   measures nothing new. Neutral ink like the sheets and slides marks
+   (ai-busy-range.ts, host-busy.css): the embedding page is monochrome, so the
+   mark is too, not the built-in AI's yellow. Below the menus (z-index 59/60) so
+   a dropdown over the page is not crossed by a frame. */
+.ai-busy-layer {
+  --ai-busy-line: rgba(13, 13, 13, 0.4);
+  --ai-busy-fill: rgba(13, 13, 13, 0.06);
+  --ai-busy-tag: #0d0d0d;
+  --ai-busy-tag-text: #ffffff;
+  position: fixed;
+  z-index: 20;
+  overflow: hidden;
+  pointer-events: none;
+}
+
+/* dark paper (styles.css .page-dark): the layer is outside it, ai-busy-frame.ts
+   copies the state over */
+.ai-busy-layer.dark {
+  --ai-busy-line: rgba(255, 255, 255, 0.45);
+  --ai-busy-fill: rgba(255, 255, 255, 0.08);
+  --ai-busy-tag: #ffffff;
+  --ai-busy-tag-text: #0d0d0d;
+}
+
+.ai-busy-frame {
+  position: absolute;
+  box-sizing: border-box;
+  border: 1px dashed var(--ai-busy-line);
+  border-radius: 2px;
+  background-image: linear-gradient(
+    90deg,
+    transparent 0%,
+    var(--ai-busy-fill) 50%,
+    transparent 100%
+  );
+  background-size: 800px 100%;
+  background-repeat: no-repeat;
+  animation: ai-busy-shimmer 1.6s linear infinite;
+}
+
+.ai-busy-label {
+  position: absolute;
+  top: -22px;
+  right: -1px;
+  padding: 0 8px;
+  border-radius: 10px;
+  background: var(--ai-busy-tag);
+  color: var(--ai-busy-tag-text);
+  font:
+    12px/20px system-ui,
+    sans-serif;
+  white-space: nowrap;
+}
+
+@keyframes ai-busy-shimmer {
+  from {
+    background-position: -800px 0;
+  }
+  to {
+    background-position: calc(100% + 800px) 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ai-busy-frame {
+    animation: none;
+  }
+}
+
+@media print {
+  .ai-busy-layer {
+    display: none;
+  }
+}
diff --git a/apps/docs/src/renderer/editor/ai-busy.ts b/apps/docs/src/renderer/editor/ai-busy.ts
new file mode 100644
index 00000000..93871721
--- /dev/null
+++ b/apps/docs/src/renderer/editor/ai-busy.ts
@@ -0,0 +1,78 @@
+import type { Editor } from '@tiptap/core'
+import './ai-busy.css'
+import { Plugin, PluginKey, type EditorState } from '@tiptap/pm/state'
+import type { EditorView } from '@tiptap/pm/view'
+import { AiBusyFrames } from './ai-busy-frame'
+
+/**
+ * "The AI is working here" marker: the top-level blocks an embedding host's
+ * agent is about to rewrite get one dashed frame per run and a label
+ * (ai-busy-frame.ts), so a person editing elsewhere in the document sees where
+ * not to type while the agent works. Laid over the editor: nothing is written
+ * to the document, the undo history or the dirty state. The host sets and
+ * clears it (host-bridge.ts).
+ */
+
+export interface AiBusyRange {
+  /** first and last top-level block index, inclusive */
+  start: number
+  end: number
+  /** shown on the first block of the range */
+  label?: string
+}
+
+const MAX_RANGES = 50
+const MAX_LABEL = 80
+
+export const aiBusyKey = new PluginKey<AiBusyRange[]>('aiBusy')
+
+/** keep only well-formed ranges from an untrusted message */
+export function sanitizeAiBusyRanges(raw: unknown): AiBusyRange[] {
+  if (!Array.isArray(raw)) return []
+  const out: AiBusyRange[] = []
+  for (const item of raw.slice(0, MAX_RANGES)) {
+    const { start, end, label } = (item ?? {}) as Record<string, unknown>
+    if (!Number.isInteger(start) || !Number.isInteger(end)) continue
+    if ((start as number) < 0 || (end as number) < (start as number)) continue
+    out.push({
+      start: start as number,
+      end: end as number,
+      ...(typeof label === 'string' && label.trim()
+        ? { label: label.trim().slice(0, MAX_LABEL) }
+        : {}),
+    })
+  }
+  return out
+}
+
+/** replace the marked ranges (an empty list clears the marker) */
+export function setAiBusy(view: EditorView, ranges: AiBusyRange[]): void {
+  view.dispatch(view.state.tr.setMeta(aiBusyKey, ranges).setMeta('addToHistory', false))
+}
+
+export function aiBusyRanges(state: EditorState): AiBusyRange[] {
+  return aiBusyKey.getState(state) ?? []
+}
+
+/**
+ * Add the marker's plugin to a live editor; returns the removal. Registered
+ * only while a host page owns the AI (host-bridge.ts installs it), so the
+ * editor's own extension list stays upstream's.
+ */
+export function registerAiBusy(editor: Editor): () => void {
+  editor.registerPlugin(
+    new Plugin<AiBusyRange[]>({
+      key: aiBusyKey,
+      state: {
+        init: () => [],
+        // block indexes, not positions: the host re-sends the ranges as its
+        // agent moves on, so they are kept as given across document edits
+        apply: (tr, value) => (tr.getMeta(aiBusyKey) as AiBusyRange[] | undefined) ?? value,
+      },
+      view: (view) => new AiBusyFrames(view, aiBusyRanges),
+    }),
+  )
+  return () => {
+    if (!editor.isDestroyed) editor.unregisterPlugin(aiBusyKey)
+  }
+}
diff --git a/apps/docs/src/renderer/host-bridge.ts b/apps/docs/src/renderer/host-bridge.ts
new file mode 100644
index 00000000..a351365d
--- /dev/null
+++ b/apps/docs/src/renderer/host-bridge.ts
@@ -0,0 +1,157 @@
+import { useCallback, useEffect, useMemo, useRef } from 'react'
+import type { Dispatch, MutableRefObject, SetStateAction } from 'react'
+import type { Editor } from '@tiptap/core'
+import { navigateToBlock } from './ai/doc-nav'
+import { getSelectionScope } from './ai/protocol'
+import { registerAiBusy, sanitizeAiBusyRanges, setAiBusy } from './editor/ai-busy'
+
+/**
+ * Host page bridge: the editor embedded in another page's iframe (web-server
+ * mode), with that page owning the AI.
+ *
+ * - "Ask AI" on a selection hands the selection and the instruction to the
+ *   host (`genoffice:ai-edit`) instead of the built-in panel;
+ * - the host can scroll to a block (`genoffice:reveal-block`, e.g. from a
+ *   "what changed" list) and mark the blocks its agent is working on
+ *   (`genoffice:ai-busy`).
+ *
+ * Off unless the editor URL names the host origin (`?host=<origin>`) and the
+ * editor really is framed by that origin; messages from any other window or
+ * origin are ignored, and replies go to that origin only.
+ */
+
+const SELECTION_TEXT_MAX = 4000
+
+export interface AiEditSelection {
+  startBlockIndex: number
+  endBlockIndex: number
+  isRange: boolean
+  text: string
+}
+
+export interface AiEditMessage {
+  type: 'genoffice:ai-edit'
+  instruction: string
+  /** true: run now; false: add to the host's pending edits */
+  send: boolean
+  selection: AiEditSelection
+}
+
+/** the embedding page's origin when a host owns the AI (shared with the other editors) */
+export { hostAiOrigin as hostOrigin } from '@genoffice/ui'
+import { hostAiOrigin as hostOrigin } from '@genoffice/ui'
+
+export function selectionForHost(editor: Editor): AiEditSelection {
+  const scope = getSelectionScope(editor)
+  const { from, to } = editor.state.selection
+  return {
+    startBlockIndex: scope.startIndex,
+    endBlockIndex: scope.endIndex,
+    isRange: scope.isRange,
+    text: editor.state.doc.textBetween(from, to, '\n', ' ').slice(0, SELECTION_TEXT_MAX),
+  }
+}
+
+export function postAiEdit(
+  editor: Editor,
+  origin: string,
+  instruction: string,
+  send: boolean,
+  win: Window = window,
+): void {
+  const message: AiEditMessage = {
+    type: 'genoffice:ai-edit',
+    instruction,
+    send,
+    selection: selectionForHost(editor),
+  }
+  win.parent.postMessage(message, origin)
+}
+
+/** Listen to the host. Returns the unsubscribe function. */
+export function installHostBridge(
+  getEditor: () => Editor | null,
+  origin: string,
+  win: Window = window,
+): () => void {
+  const onMessage = (event: MessageEvent): void => {
+    if (event.source !== win.parent || event.origin !== origin) return
+    const data = event.data as { type?: unknown; index?: unknown; ranges?: unknown } | null
+    if (!data || typeof data.type !== 'string') return
+    const editor = getEditor()
+    if (!editor || editor.isDestroyed) return
+    if (data.type === 'genoffice:reveal-block') {
+      if (Number.isInteger(data.index) && (data.index as number) >= 0) {
+        navigateToBlock(editor, data.index as number)
+      }
+    } else if (data.type === 'genoffice:ai-busy') {
+      setAiBusy(editor.view, sanitizeAiBusyRanges(data.ranges))
+    }
+  }
+  const initial = getEditor()
+  const unregisterBusy = initial ? registerAiBusy(initial) : () => {}
+  win.addEventListener('message', onMessage)
+  win.parent.postMessage({ type: 'genoffice:ready' }, origin)
+  return () => {
+    win.removeEventListener('message', onMessage)
+    unregisterBusy()
+  }
+}
+
+/** the pending request for the built-in assistant panel (App's aiPreset state) */
+type AiPreset = { text: string } | null
+
+/**
+ * When the embedding host owns the AI, every request meant for the built-in
+ * assistant panel — the selection's "Ask AI", ribbon presets (Editor,
+ * Translate…), the context menu, F7, the Tools menu — goes to the host
+ * instead: they all start the panel by setting its preset, so wrapping that
+ * one setter covers them all and App keeps its own code paths.
+ */
+export function useHostOwnedAi<P extends AiPreset>(
+  setPreset: Dispatch<SetStateAction<P>>,
+): {
+  readonly origin: string | null
+  readonly setPreset: Dispatch<SetStateAction<P>>
+  /** the selection's "add to queue": the host's composer is the queue; true when handled */
+  readonly queue: (instruction: string) => boolean
+  readonly editorRef: MutableRefObject<Editor | null>
+} {
+  const origin = useMemo(() => hostOrigin(), [])
+  const editorRef = useRef<Editor | null>(null)
+  const wrapped = useCallback<Dispatch<SetStateAction<P>>>(
+    (next) => {
+      const editor = editorRef.current
+      if (origin && editor && next !== null && typeof next === 'object' && 'text' in next) {
+        postAiEdit(editor, origin, next.text, true)
+        return
+      }
+      setPreset(next)
+    },
+    [origin, setPreset],
+  )
+  const queue = useCallback(
+    (instruction: string) => {
+      const editor = editorRef.current
+      if (!origin || !editor) return false
+      if (!editor.state.selection.empty) postAiEdit(editor, origin, instruction, false)
+      return true
+    },
+    [origin],
+  )
+  return { origin, setPreset: wrapped, queue, editorRef }
+}
+
+/** give the host-owned AI the live editor and listen to the host page */
+export function useHostBridge(
+  hostAi: { readonly origin: string | null; readonly editorRef: MutableRefObject<Editor | null> },
+  editor: Editor | null,
+  tornDown: boolean,
+): void {
+  hostAi.editorRef.current = editor
+  const { origin } = hostAi
+  useEffect(() => {
+    if (tornDown || !editor || !origin) return
+    return installHostBridge(() => editor, origin)
+  }, [tornDown, editor, origin])
+}

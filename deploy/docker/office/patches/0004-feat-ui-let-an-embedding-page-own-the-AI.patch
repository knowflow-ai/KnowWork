@@ -0,0 +1,118 @@
+/**
+ * When a host page owns the AI (embedded editor, ?host=), the selection's ask
+ * popover is the host chat's inline ask: Enter sends the request at once and
+ * the footer has the one "send now" button — no queue, which is the host's
+ * composer.
+ */
+import { act, createElement } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import type { Editor } from '@tiptap/core'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@genoffice/ui', async (original) => ({
+  ...(await original<typeof import('@genoffice/ui')>()),
+  hostOwnsAi: () => true,
+}))
+
+import { applyAiPanelPrefs } from '@genoffice/ui'
+import { AiAskPopover } from '../src/renderer/components/AiAskPopover'
+
+let coords: { left: number; right: number; top: number; bottom: number }
+let listeners: Map<string, () => void>
+let noop: () => void
+
+function makeEditor(): Editor {
+  const tr: Record<string, unknown> = {}
+  tr.setMeta = () => tr
+  const state = {
+    selection: { empty: false, from: 1, to: 5 },
+    doc: { textBetween: () => '\u673aIF\u6539' },
+    tr,
+  }
+  const listenersMap = listeners
+  return {
+    state,
+    isFocused: true,
+    isDestroyed: false,
+    view: {
+      coordsAtPos: () => coords,
+      dispatch: noop,
+    },
+    on: (event: string, handler: () => void) => listenersMap.set(event, handler),
+    off: (event: string) => listenersMap.delete(event),
+  } as unknown as Editor
+}
+
+let host: HTMLDivElement
+let root: Root
+const sendNow = vi.fn()
+const queueAdd = vi.fn()
+
+function mount(): void {
+  host = document.createElement('div')
+  document.body.append(host)
+  root = createRoot(host)
+  act(() =>
+    root.render(
+      createElement(AiAskPopover, {
+        editor: makeEditor(),
+        queueFull: false,
+        getItem: () => undefined,
+        onSendNow: sendNow,
+        onQueueAdd: queueAdd,
+        onQueueUpdate: noop,
+        onQueueRemove: noop,
+      }),
+    ),
+  )
+}
+
+beforeEach(() => {
+  vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true)
+  applyAiPanelPrefs({})
+  coords = { left: 10, right: 20, top: 30, bottom: 45 }
+  listeners = new Map()
+  noop = () => {}
+  sendNow.mockReset()
+  queueAdd.mockReset()
+})
+
+afterEach(() => {
+  act(() => root.unmount())
+  host.remove()
+  vi.unstubAllGlobals()
+})
+
+function type(value: string): HTMLInputElement {
+  const input = host.querySelector<HTMLInputElement>('.ai-ask-pop-input')!
+  const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!.set!
+  act(() => {
+    setter.call(input, value)
+    input.dispatchEvent(new Event('input', { bubbles: true }))
+  })
+  return input
+}
+
+describe('AiAskPopover when a host owns the AI', () => {
+  it('Enter sends the request at once', () => {
+    mount()
+    act(() => host.querySelector<HTMLButtonElement>('.ai-ask-trigger')!.click())
+    const input = type('改简洁些')
+    act(() => {
+      input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }))
+    })
+    expect(sendNow).toHaveBeenCalledWith('改简洁些')
+    expect(queueAdd).not.toHaveBeenCalled()
+    expect(host.querySelector('.ai-ask-pop')).toBeNull()
+  })
+
+  it('the footer has only the send button', () => {
+    mount()
+    act(() => host.querySelector<HTMLButtonElement>('.ai-ask-trigger')!.click())
+    type('加个句号')
+    const buttons = [...host.querySelectorAll<HTMLButtonElement>('.ai-ask-pop-foot button')]
+    expect(buttons).toHaveLength(1)
+    act(() => buttons[0]!.click())
+    expect(sendNow).toHaveBeenCalledWith('加个句号')
+  })
+})
diff --git a/apps/docs/tests/ai-busy-frame.test.ts b/apps/docs/tests/ai-busy-frame.test.ts

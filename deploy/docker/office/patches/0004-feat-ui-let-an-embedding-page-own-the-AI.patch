+import { describe, expect, it, vi } from 'vitest'
+import { tellHostAgentEdited } from '../src/web/shim/host-page'
+
+// the browser side of the agent edit notice: an editor embedded in a host page
+// (?host= names it, and it really is the framing page) passes it on; a tab
+// opened on its own has no one to tell
+const HOST = 'https://kw.example'
+function fakeWindow(search: string, ancestors: string[] = [HOST]) {
+  const parent = { postMessage: vi.fn() }
+  const win = { parent, location: { search, ancestorOrigins: ancestors } }
+  return win as unknown as Window & { parent: typeof parent }
+}
+
+describe('telling an embedding host', () => {
+  it('passes an agent edit on to the host page that frames the editor', () => {
+    const win = fakeWindow(`?path=%2Fw%2Fa.docx&host=${encodeURIComponent(HOST)}`)
+    tellHostAgentEdited(win)
+    expect(win.parent.postMessage).toHaveBeenCalledWith({ type: 'genoffice:agent-edited' }, HOST)
+  })
+
+  it('tells no one when not embedded, or when the framing page is not the named host', () => {
+    const alone = fakeWindow('?path=%2Fw%2Fa.docx')
+    tellHostAgentEdited(alone)
+    expect(alone.parent.postMessage).not.toHaveBeenCalled()
+    const framedElsewhere = fakeWindow(`?host=${encodeURIComponent(HOST)}`, [
+      'https://evil.example',
+    ])
+    tellHostAgentEdited(framedElsewhere)
+    expect(framedElsewhere.parent.postMessage).not.toHaveBeenCalled()
+  })
+})

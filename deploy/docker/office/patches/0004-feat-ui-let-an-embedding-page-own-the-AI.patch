@@ -0,0 +1,41 @@
+/**
+ * "An embedding page owns the AI" (web-server mode).
+ *
+ * When an editor runs inside another page's iframe and its URL names that
+ * page as the host (`?host=<origin>`), the page offers its own assistant and
+ * the editor must not show a second one: the AI panel and its rail stay off
+ * (useAiSidebarEnabled), and `<html data-host-ai>` hides the remaining entry
+ * points — the AI ribbon groups, the slide stage's AI bar, "Name with AI" —
+ * through host-ai.css. The selection "Ask AI" popover of Docs stays:
+ * it hands the request to the host (docs host-bridge.ts).
+ *
+ * The URL alone is not enough: Chromium reports the real framing origin, so a
+ * page that merely copies the URL into its own frame cannot claim the role.
+ */
+
+import './host-ai.css'
+
+export { hostAiOrigin } from './host-origin'
+import { hostAiOrigin } from './host-origin'
+
+let owned: boolean | null = null
+
+/** whether this page's AI belongs to the embedding host (fixed for the page's life) */
+export function hostOwnsAi(): boolean {
+  owned ??= typeof window !== 'undefined' && hostAiOrigin(window) !== null
+  return owned
+}
+
+/** mark `<html>` so the shared stylesheet hides the editor's own AI entry points */
+export function markHostOwnedAi(): void {
+  if (hostOwnsAi()) document.documentElement.dataset.hostAi = ''
+}
+
+/** test seam: forget the cached answer */
+export function resetHostOwnsAiForTests(): void {
+  owned = null
+}
+
+// every app's renderer imports this package before it renders, so the page is
+// marked as soon as the module loads and no app entry has to call it
+if (typeof document !== 'undefined') markHostOwnedAi()

+++ b/packages/ui/tests/host-ai.test.ts
@@ -0,0 +1,37 @@
+/** @vitest-environment jsdom */
+/**
+ * An embedding page that owns the AI (web-server mode, `?host=<origin>`, framed
+ * by that origin) makes the editors hide their own AI: the sidebar switch reads
+ * off, and `<html data-host-ai>` drives the stylesheet. A top-level page, or a
+ * frame whose real parent is someone else, keeps the editor's AI.
+ */
+import { afterEach, describe, expect, it } from 'vitest'
+import { hostAiOrigin, hostOwnsAi, markHostOwnedAi, resetHostOwnsAiForTests } from '../src/host-ai'
+
+const HOST = 'https://kw.example'
+const framed = (search: string, ancestors?: string[]): Window =>
+  ({
+    parent: {},
+    location: { search, ...(ancestors ? { ancestorOrigins: ancestors } : {}) },
+  }) as unknown as Window
+
+afterEach(() => {
+  resetHostOwnsAiForTests()
+  delete document.documentElement.dataset.hostAi
+})
+
+describe('host-owned AI', () => {
+  it('needs a frame, a host parameter and a matching framing origin', () => {
+    expect(hostAiOrigin(framed(`?host=${HOST}/chat`))).toBe(HOST)
+    expect(hostAiOrigin(framed(`?host=${HOST}`, [HOST]))).toBe(HOST)
+    expect(hostAiOrigin(framed(`?host=${HOST}`, ['https://evil.example']))).toBeNull()
+    expect(hostAiOrigin(framed('?path=/x.docx'))).toBeNull()
+    expect(hostAiOrigin(framed('?host=not a url'))).toBeNull()
+  })
+
+  it('leaves a top-level editor its own AI', () => {
+    expect(hostOwnsAi()).toBe(false)
+    markHostOwnedAi()
+    expect(document.documentElement.dataset.hostAi).toBeUndefined()
+  })
+})

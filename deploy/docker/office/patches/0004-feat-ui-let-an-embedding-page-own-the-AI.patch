--- /dev/null
+++ b/packages/ui/src/host-ai.css
@@ -0,0 +1,87 @@
+/* When a host page owns the AI (KnowWork; host-ai.ts marks <html data-host-ai>):
+   the editor's own AI entry points go, and the selection's ask follows the
+   host's monochrome chat. Loaded by host-ai.ts so no app entry imports it. */
+/* An embedding page owns the AI (host-ai.ts): the editor shows none of its own
+   AI entry points — the AI ribbon groups and the separator after them, single
+   AI actions in other groups (.ai-action), AI-badged context menu items, the
+   slide stage's AI bar, "Name with AI", the rail and the panel itself (an
+   explicit shortcut for the assistant would otherwise still open it). !important: these
+   must beat every per-app and panel-side rule. */
+html[data-host-ai] .ribbon-group:has(.ai-entry),
+html[data-host-ai] .ribbon-group:has(.ai-entry) + .ribbon-sep,
+html[data-host-ai] .ai-action,
+html[data-host-ai] .ctx-item:has(.copilot-badge),
+html[data-host-ai] .ctx-item-wrap:has(.copilot-badge),
+html[data-host-ai] .ctx-sep:has(+ .ctx-item .copilot-badge),
+html[data-host-ai] .stage-ai-bar,
+html[data-host-ai] .qa-name-with-ai,
+html[data-host-ai] .ai-rail,
+html[data-host-ai] .ai-dock,
+html[data-host-ai] .sheet-body > .copilot {
+  display: none !important;
+}
+
+html[data-host-ai] .sheet-body {
+  grid-template-columns: minmax(0, 1fr) !important;
+}
+
+/* An embedding host's chat is monochrome (it follows ChatGPT's look), so the
+   one AI entry left in the editor — the selection's "Ask AI" bubble and its
+   popover — drops the orange AI accent for the editor's own text and surface
+   colors (dark pages included): pill buttons, a softer shadow, a neutral
+   focus ring. */
+html[data-host-ai] {
+  --color-ai-action: var(--text);
+  --color-ai-action-hover: var(--text);
+  --color-ai-action-text: var(--surface);
+}
+
+html[data-host-ai] .ai-ask-trigger {
+  padding: 6px 12px;
+  color: var(--text);
+  box-shadow:
+    0 4px 16px rgba(0, 0, 0, 0.08),
+    0 0 1px rgba(0, 0, 0, 0.16);
+}
+
+html[data-host-ai] .ai-ask-pop {
+  padding: 14px;
+  border-radius: 16px;
+  box-shadow:
+    0 8px 28px rgba(0, 0, 0, 0.1),
+    0 0 1px rgba(0, 0, 0, 0.16);
+}
+
+html[data-host-ai] .ai-ask-pop-input {
+  padding: 9px 12px;
+  border-radius: 12px;
+  background: var(--surface);
+  font-size: 14px;
+}
+
+html[data-host-ai] .ai-ask-pop-input:focus {
+  border-color: var(--text-dim);
+}
+
+html[data-host-ai] .ai-ask-cancel,
+html[data-host-ai] .ai-ask-confirm {
+  padding: 6px 14px;
+  border-radius: 999px;
+  font-size: 13px;
+}
+
+html[data-host-ai] .ai-ask-confirm:hover:not(:disabled) {
+  opacity: 0.85;
+}
+
+/* while an ask popover is open, the other selection's Ask AI chip stays hidden
+   (slides: a text box's ask leaves the box selected, whose own chip would show) */
+html[data-host-ai] body:has(.ai-ask-pop) .ai-ask-trigger {
+  display: none !important;
+}
+
+/* the save toast's check (docs, sheets, slides: .app-toast.success) takes the
+   toast's own ink instead of the system green, like the host's monochrome toasts */
+html[data-host-ai] .app-toast.success .app-toast-icon {
+  color: inherit;
+}

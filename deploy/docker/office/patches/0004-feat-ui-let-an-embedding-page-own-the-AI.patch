+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { tellAgentEdited } from '../src/main/mcp/agent-edited'
+import { registerWebTab, unregisterWebTab } from '../src/web/tab-registry'
+import type { WebTabContents } from '../src/web/web-contents'
+
+// an agent's edit landed in a document: a browser tab embedded in a host page
+// hears about it (the host takes down its "AI at work" mark); desktop windows
+// have no host page and are left alone
+const tabs: WebTabContents[] = []
+function browserTab(id: number) {
+  const tab = { id, send: vi.fn() } as unknown as WebTabContents
+  registerWebTab(tab)
+  tabs.push(tab)
+  return tab
+}
+afterEach(() => {
+  for (const tab of tabs.splice(0)) unregisterWebTab(tab)
+})
+
+describe('agent edit notice', () => {
+  it('tells the browser tab showing the document', () => {
+    const tab = browserTab(1_000_001)
+    tellAgentEdited(1_000_001)
+    expect(tab.send).toHaveBeenCalledWith('web:agent-edited')
+  })
+
+  it('sends nothing for a desktop window or a tab that has closed', () => {
+    const other = browserTab(1_000_002)
+    expect(() => tellAgentEdited(7)).not.toThrow()
+    expect(() => tellAgentEdited(1_000_003)).not.toThrow()
+    expect(other.send).not.toHaveBeenCalled()
+  })
+})

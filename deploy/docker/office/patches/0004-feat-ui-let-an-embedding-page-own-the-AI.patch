+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { z } from 'zod'
+
+vi.mock('../../src/main/mcp/agent-edited', () => ({ tellAgentEdited: vi.fn() }))
+
+import { tellAgentEdited } from '../../src/main/mcp/agent-edited'
+import { createDocxAgentTools } from '../../src/main/mcp/tools/docx-agent-tools'
+import { createXlsxAgentTools } from '../../src/main/mcp/tools/xlsx-agent-tools'
+
+// the Word and Excel run tools tell the document's tab when the agent's call
+// changed the document (mutated), so an embedding host can take down its
+// "AI at work" mark as soon as the edit lands; a call that changed nothing
+// (no match, a read) leaves the mark until the turn ends
+const documentField = z.string().optional()
+const target = (async () => 41) as never
+
+function runTool(
+  tools: { name: string; handler: (args: never) => Promise<unknown> }[],
+  name: string,
+) {
+  const tool = tools.find((t) => t.name === name)
+  if (!tool) throw new Error(`no ${name}`)
+  return tool.handler({ tool: 'apply_ops', input: {} } as never)
+}
+
+beforeEach(() => vi.mocked(tellAgentEdited).mockClear())
+
+describe('agent edit notice from the run tools', () => {
+  it('Word: a call that changed the document tells its tab; one that did not stays quiet', async () => {
+    let mutated = false
+    const docs = { runCommand: vi.fn(async () => ({ summary: '', output: '', mutated })) }
+    const tools = createDocxAgentTools(target, docs as never, documentField)
+    await runTool(tools as never, 'run_docx_tool')
+    expect(tellAgentEdited).not.toHaveBeenCalled()
+    mutated = true
+    const result = await runTool(tools as never, 'run_docx_tool')
+    expect(tellAgentEdited).toHaveBeenCalledWith(41)
+    expect(result).toMatchObject({ mutated: true })
+  })
+
+  it('Excel: the same', async () => {
+    let mutated = false
+    const sheets = { runCommand: vi.fn(async () => ({ summary: '', output: '', mutated })) }
+    const tools = createXlsxAgentTools(target, sheets as never, documentField)
+    await runTool(tools as never, 'run_xlsx_tool')
+    expect(tellAgentEdited).not.toHaveBeenCalled()
+    mutated = true
+    await runTool(tools as never, 'run_xlsx_tool')
+    expect(tellAgentEdited).toHaveBeenCalledWith(41)
+  })
+})

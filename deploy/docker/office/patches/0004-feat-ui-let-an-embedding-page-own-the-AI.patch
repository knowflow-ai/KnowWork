+import { describe, expect, it } from 'vitest'
+import { busyCellsOf, hostScopeOf, sheetsAiEditMessage } from '../src/renderer/host-bridge'
+
+describe('sheets host bridge (an embedding page owns the AI)', () => {
+  it('names the selected range by its worksheet', () => {
+    const sheets = () => ({ sheets: [{ id: 's-1', name: 'Sheet1' }, { id: 's-2', name: '明细' }] })
+    expect(hostScopeOf({ a1: 'B3:D6', sheetId: 's-2' }, sheets)()).toEqual({ sheet: '明细', range: 'B3:D6' })
+    expect(hostScopeOf({ a1: 'B3:D6', sheetId: 'gone' }, sheets)()).toBeNull()
+    expect(hostScopeOf(null, sheets)()).toBeNull()
+  })
+
+  it('hands the instruction and the range over', () => {
+    expect(sheetsAiEditMessage('保留两位小数', true, { sheet: '明细', range: 'B3:D6' })).toEqual({
+      type: 'genoffice:ai-edit',
+      instruction: '保留两位小数',
+      send: true,
+      selection: { isRange: true, text: '', sheet: '明细', range: 'B3:D6' },
+    })
+    expect(sheetsAiEditMessage('翻译成英文', true, null).selection).toEqual({ isRange: false, text: '' })
+  })
+
+  it('reads the host busy mark; anything else clears it', () => {
+    expect(busyCellsOf({ sheet: '明细', range: 'B3:D6', label: 'AI 正在改' })).toEqual({
+      sheet: '明细',
+      range: 'B3:D6',
+      label: 'AI 正在改',
+    })
+    expect(busyCellsOf({ sheet: '明细', range: 'B3' })?.label).toBe('AI')
+    expect(busyCellsOf(undefined)).toBeNull()
+    expect(busyCellsOf({ sheet: '', range: 'B3' })).toBeNull()
+  })
+})

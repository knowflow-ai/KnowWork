+import { useLayoutEffect, useState } from 'react'
+import type { AnchorRect } from './components/AiAskPopover'
+import './host-busy.css'
+
+/**
+ * "The AI is working here" over the slide elements the host's agent is
+ * changing (host-bridge.ts: `genoffice:ai-busy` with `slide`): a dashed frame
+ * and a label laid over the canvas. Decoration only — never part of the deck;
+ * the host clears it when the turn ends. Follows the canvas as it scrolls.
+ */
+export function HostBusyFrame({
+  rect,
+  label,
+}: {
+  /** viewport box of the elements; null hides the frame */
+  readonly rect: () => AnchorRect | null
+  readonly label: string
+}): React.JSX.Element | null {
+  const [box, setBox] = useState<AnchorRect | null>(() => rect())
+  useLayoutEffect(() => {
+    const update = (): void => setBox(rect())
+    update()
+    const scroller = document.querySelector('.stage-wrap')
+    scroller?.addEventListener('scroll', update, { passive: true })
+    window.addEventListener('resize', update)
+    return () => {
+      scroller?.removeEventListener('scroll', update)
+      window.removeEventListener('resize', update)
+    }
+  }, [rect])
+  if (!box) return null
+  return (
+    <div
+      className="host-busy-frame"
+      aria-hidden
+      style={{ left: box.left, top: box.top, width: box.right - box.left, height: box.bottom - box.top }}
+    >
+      <span className="host-busy-label">{label}</span>
+    </div>
+  )
+}

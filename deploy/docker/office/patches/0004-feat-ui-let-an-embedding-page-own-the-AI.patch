diff --git a/apps/sheets/src/renderer/ai-busy-range.ts b/apps/sheets/src/renderer/ai-busy-range.ts
new file mode 100644
index 00000000..3c684f3f
--- /dev/null
+++ b/apps/sheets/src/renderer/ai-busy-range.ts
@@ -0,0 +1,131 @@
+import type { IRange, IScale } from '@univerjs/core'
+import {
+  IRenderManagerService,
+  SheetExtension,
+  SpreadsheetExtensionRegistry,
+  type IDrawInfo,
+  type SpreadsheetSkeleton,
+  type UniverRenderingContext,
+} from '@univerjs/engine-render'
+import { parseRange, type RangeBounds } from '@genoffice/xlsx-gateway/domain/cell-address'
+import type { UniverRuntime } from './univer-state'
+
+/**
+ * "The AI is working here" on the grid, for an embedding page that owns the AI
+ * (host-bridge.ts): while the host's agent works on the range the user handed
+ * over, the range gets a dashed outline, a light fill and a label. Decoration
+ * only — painted by a canvas extension like the cross highlight, never written
+ * into the workbook or the undo history; the host clears it when the turn ends.
+ */
+
+export interface AiBusyCells {
+  /** worksheet name */
+  readonly sheet: string
+  /** A1 range on that sheet */
+  readonly range: string
+  readonly label: string
+}
+
+interface BusyState {
+  readonly workbookId: string
+  readonly sheetId: string
+  readonly bounds: RangeBounds
+  readonly label: string
+}
+
+let busy: BusyState | null = null
+let runtimeRef: UniverRuntime | null = null
+
+const COLORS = { fill: 'rgba(13, 13, 13, 0.04)', line: 'rgba(13, 13, 13, 0.55)', text: '#0d0d0d', tag: '#ffffff' }
+
+/**
+ * Grid extension above cell text (45) and borders (50), so the label stays
+ * legible over the row it sits in; the fill is faint enough to read through.
+ * Skipped when printing.
+ */
+export class AiBusyRangeExtension extends SheetExtension {
+  readonly uKey = 'GenOfficeAiBusyRangeExtension'
+  protected Z_INDEX = 55
+
+  override draw(
+    ctx: UniverRenderingContext,
+    _parentScale: IScale,
+    skeleton: SpreadsheetSkeleton,
+    _diffRanges: IRange[] | undefined,
+    _drawInfo?: IDrawInfo,
+  ): void {
+    const state = busy
+    const worksheet = skeleton.worksheet
+    if (!state || ctx.__mode === 'printing' || !worksheet) return
+    if (worksheet.unitId !== state.workbookId || worksheet.getSheetId() !== state.sheetId) return
+    const first = skeleton.getCellWithCoordByIndex(state.bounds.startRow, state.bounds.startColumn, false)
+    const last = skeleton.getCellWithCoordByIndex(state.bounds.endRow, state.bounds.endColumn, false)
+    if (!first || !last) return
+    const left = first.startX
+    const top = first.startY
+    const width = last.endX - left
+    const height = last.endY - top
+    const { scaleX, scaleY } = ctx.getScale()
+    const unit = 1 / Math.max(scaleX, scaleY, 1)
+    ctx.save()
+    ctx.fillStyle = COLORS.fill
+    ctx.fillRect(left, top, width, height)
+    ctx.strokeStyle = COLORS.line
+    ctx.lineWidth = 1.5 * unit
+    ctx.setLineDash([4 * unit, 3 * unit])
+    ctx.strokeRect(left, top, width, height)
+    ctx.setLineDash([])
+    ctx.font = `${12 * unit}px -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif`
+    const textWidth = ctx.measureText(state.label).width
+    const tagHeight = 18 * unit
+    const tagTop = top >= tagHeight ? top - tagHeight : top
+    ctx.fillStyle = COLORS.text
+    ctx.fillRect(left, tagTop, textWidth + 12 * unit, tagHeight)
+    ctx.fillStyle = COLORS.tag
+    ctx.textBaseline = 'middle'
+    ctx.fillText(state.label, left + 6 * unit, tagTop + tagHeight / 2)
+    ctx.restore()
+  }
+}
+
+SpreadsheetExtensionRegistry.add(AiBusyRangeExtension)
+
+function repaint(workbookId: string): void {
+  if (!runtimeRef || !workbookId) return
+  try {
+    const render = runtimeRef.univer.__getInjector().get(IRenderManagerService).getRenderById(workbookId)
+    render?.mainComponent?.makeDirty(true)
+    render?.scene?.makeDirty(true)
+  } catch {
+    // render modules may not exist yet while a workbook is being replaced
+  }
+}
+
+/** the grid the decoration paints on (App installs it with the Univer runtime; returns the uninstall) */
+export function installAiBusyRange(runtime: UniverRuntime): () => void {
+  runtimeRef = runtime
+  return () => {
+    showAiBusyCells(null)
+    if (runtimeRef === runtime) runtimeRef = null
+  }
+}
+
+/** mark the range the host's agent is working on; null (or a range not in this workbook) clears it */
+export function showAiBusyCells(cells: AiBusyCells | null): void {
+  const previous = busy?.workbookId ?? ''
+  busy = resolve(cells)
+  repaint(previous)
+  if (busy && busy.workbookId !== previous) repaint(busy.workbookId)
+}
+
+function resolve(cells: AiBusyCells | null): BusyState | null {
+  if (!cells || !runtimeRef) return null
+  try {
+    const workbook = runtimeRef.univerAPI.getActiveWorkbook()
+    const sheet = workbook?.getSheetByName(cells.sheet)
+    if (!workbook || !sheet) return null
+    return { workbookId: workbook.getId(), sheetId: sheet.getSheetId(), bounds: parseRange(cells.range), label: cells.label }
+  } catch {
+    return null
+  }
+}
diff --git a/apps/sheets/src/renderer/host-bridge.ts b/apps/sheets/src/renderer/host-bridge.ts
new file mode 100644
index 00000000..6b7a2fa5
--- /dev/null
+++ b/apps/sheets/src/renderer/host-bridge.ts
@@ -0,0 +1,115 @@
+import { useEffect, useMemo } from 'react'
+import { hostAiOrigin } from '@genoffice/ui'
+import { showAiBusyCells, type AiBusyCells } from './ai-busy-range'
+import type { ActiveSheetInfo, FrozenSelection } from './ai/tools'
+
+/**
+ * Host page bridge for the spreadsheet: the editor embedded in another page's
+ * iframe (web-server mode), with that page owning the AI (see the docs app's
+ * host-bridge.ts for the protocol).
+ *
+ * The selection bubble's "Ask AI" and the ribbon's AI actions (Translate) hand
+ * the instruction and the selected range to the host (`genoffice:ai-edit`)
+ * instead of opening the built-in panel. The range names its worksheet so the
+ * host's agent addresses the same cells even after the user switches sheets.
+ *
+ * The host marks the range its agent is working on (`genoffice:ai-busy` with
+ * `cells: { sheet, range, label }`; anything else clears it), drawn by
+ * ai-busy-range.ts.
+ *
+ * Off unless the editor URL names the host origin (`?host=<origin>`) and the
+ * editor really is framed by that origin.
+ */
+
+export interface SheetsHostScope {
+  /** worksheet name */
+  sheet: string
+  /** A1 range on that sheet */
+  range: string
+}
+
+export interface SheetsAiEditMessage {
+  type: 'genoffice:ai-edit'
+  instruction: string
+  /** true: run now; false: add to the host's pending edits */
+  send: boolean
+  selection: { isRange: boolean; text: string; sheet?: string; range?: string }
+}
+
+/**
+ * The selection the host gets, kept current by App on every render (it alone
+ * knows the workbook's sheets): ExcelShell's AI entries read it when they hand
+ * a request over.
+ */
+export const sheetsHostScope: { current: () => SheetsHostScope | null } = { current: () => null }
+
+/** the live selection as the host sees it: its sheet's name and A1 range */
+export function hostScopeOf(
+  scope: FrozenSelection | null,
+  info: () => Pick<ActiveSheetInfo, 'sheets'>,
+): () => SheetsHostScope | null {
+  return () => {
+    if (!scope) return null
+    const sheet = info().sheets.find((candidate) => candidate.id === scope.sheetId)
+    return sheet ? { sheet: sheet.name, range: scope.a1 } : null
+  }
+}
+
+/** the host's busy mark, or null when the message clears it or is malformed */
+export function busyCellsOf(raw: unknown): AiBusyCells | null {
+  if (!raw || typeof raw !== 'object') return null
+  const { sheet, range, label } = raw as Record<string, unknown>
+  if (typeof sheet !== 'string' || typeof range !== 'string' || !sheet || !range) return null
+  return { sheet, range, label: typeof label === 'string' && label ? label.slice(0, 40) : 'AI' }
+}
+
+export function sheetsAiEditMessage(
+  instruction: string,
+  send: boolean,
+  scope: SheetsHostScope | null,
+): SheetsAiEditMessage {
+  return {
+    type: 'genoffice:ai-edit',
+    instruction,
+    send,
+    selection: scope
+      ? { isRange: true, text: '', sheet: scope.sheet, range: scope.range }
+      : { isRange: false, text: '' },
+  }
+}
+
+/**
+ * When the embedding host owns the AI, `send` hands an AI request to it and
+ * returns true; otherwise it returns false and the caller runs the built-in
+ * assistant as before.
+ */
+export function useSheetsHostAi(): { readonly send: (instruction: string) => boolean } {
+  const origin = useMemo(() => hostAiOrigin(), [])
+  useEffect(() => {
+    if (!origin) return
+    const onMessage = (event: MessageEvent): void => {
+      if (event.source !== window.parent || event.origin !== origin) return
+      const data = event.data as { type?: unknown; cells?: unknown } | null
+      if (data?.type === 'genoffice:ai-busy') showAiBusyCells(busyCellsOf(data.cells))
+    }
+    window.addEventListener('message', onMessage)
+    window.parent.postMessage({ type: 'genoffice:ready' }, origin)
+    return () => {
+      window.removeEventListener('message', onMessage)
+      showAiBusyCells(null)
+    }
+  }, [origin])
+  return useMemo(
+    () => ({
+      send: (instruction: string) => {
+        if (!origin) return false
+        window.parent.postMessage(
+          sheetsAiEditMessage(instruction, true, sheetsHostScope.current()),
+          origin,
+        )
+        return true
+      },
+    }),
+    [origin],
+  )
+}

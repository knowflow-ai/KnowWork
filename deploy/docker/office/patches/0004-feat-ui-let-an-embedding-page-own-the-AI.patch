diff --git a/apps/docs/src/renderer/editor/ai-busy-frame.ts b/apps/docs/src/renderer/editor/ai-busy-frame.ts
new file mode 100644
index 00000000..9a4c16c4
--- /dev/null
+++ b/apps/docs/src/renderer/editor/ai-busy-frame.ts
@@ -0,0 +1,222 @@
+import type { EditorState, PluginView } from '@tiptap/pm/state'
+import type { EditorView } from '@tiptap/pm/view'
+import type { AiBusyRange } from './ai-busy'
+
+/**
+ * The frames of the "AI is working here" marker (ai-busy.ts): one dashed box
+ * per run of marked blocks, not one per block, so a long range reads as one
+ * piece. Laid over the editor in a layer of its own rather than drawn on the
+ * blocks: an outline per block cannot bridge the paragraph spacing, the
+ * blocks' pseudo-elements are taken (paragraph marks, revision badges, which
+ * the agent's tracked changes bring along), and ProseMirror owns every node
+ * under its root. A run ends where a page gap or a column break falls between
+ * two blocks, so a range over a page boundary gets a box on each page.
+ * Measured from the DOM after layout; nothing here feeds pagination.
+ */
+
+export interface BlockBox {
+  /** client px */
+  top: number
+  bottom: number
+  left: number
+  right: number
+  /** a page gap sits between this block and the previous one of the range */
+  breakBefore: boolean
+}
+
+export interface Box {
+  top: number
+  bottom: number
+  left: number
+  right: number
+}
+
+/** frame lines sit this far outside the text (client px) */
+const PAD = 4
+/** a run continues downward only; slack for sub-pixel layout */
+const SLACK = 1
+
+/** group the measured blocks of one range into frames (client px) */
+export function framesOf(blocks: readonly BlockBox[]): Box[] {
+  const runs = blocks.reduce<Box[]>((done, block) => {
+    const last = done[done.length - 1]
+    const continues =
+      last !== undefined &&
+      !block.breakBefore &&
+      block.top >= last.bottom - SLACK &&
+      block.left < last.right
+    if (!continues) return [...done, { ...block }]
+    const merged = {
+      top: last.top,
+      bottom: Math.max(last.bottom, block.bottom),
+      left: Math.min(last.left, block.left),
+      right: Math.max(last.right, block.right),
+    }
+    return [...done.slice(0, -1), merged]
+  }, [])
+  return runs.map((run) => ({
+    top: run.top - PAD,
+    bottom: run.bottom + PAD,
+    left: run.left - PAD,
+    right: run.right + PAD,
+  }))
+}
+
+/** a page gap widget (pagination-gaps.ts) between two top-level blocks */
+function pageGapBetween(previous: Element, next: Element): boolean {
+  for (
+    let node = previous.nextElementSibling;
+    node && node !== next;
+    node = node.nextElementSibling
+  ) {
+    if (node.classList.contains('page-gap')) return true
+  }
+  return false
+}
+
+/** the visible top-level blocks of a range, measured */
+function measure(view: EditorView, range: AiBusyRange): BlockBox[] {
+  const boxes: BlockBox[] = []
+  let previous: Element | null = null
+  view.state.doc.forEach((_node, offset, index) => {
+    if (index < range.start || index > range.end) return
+    const dom = view.nodeDOM(offset)
+    if (!(dom instanceof HTMLElement)) return
+    const rect = dom.getBoundingClientRect()
+    if (rect.width === 0 && rect.height === 0) return // not rendered (display: none)
+    const breakBefore = previous !== null && pageGapBetween(previous, dom)
+    boxes.push({
+      top: rect.top,
+      bottom: rect.bottom,
+      left: rect.left,
+      right: rect.right,
+      breakBefore,
+    })
+    previous = dom
+  })
+  return boxes
+}
+
+/** '' where the engine computes no overflow (jsdom) */
+const clips = (overflow: string) => overflow !== '' && overflow !== 'visible'
+
+/** the part of the viewport the editor shows: every clipping ancestor (the
+ *  scrolling pane, the multi-page clip window) cut out of the window */
+function visibleArea(el: Element): Box {
+  let area: Box = { top: 0, left: 0, right: window.innerWidth, bottom: window.innerHeight }
+  for (let node = el.parentElement; node && node !== document.body; node = node.parentElement) {
+    const style = getComputedStyle(node)
+    if (!clips(style.overflowX) && !clips(style.overflowY)) continue
+    const rect = node.getBoundingClientRect()
+    area = {
+      top: Math.max(area.top, rect.top),
+      left: Math.max(area.left, rect.left),
+      right: Math.min(area.right, rect.right),
+      bottom: Math.min(area.bottom, rect.bottom),
+    }
+  }
+  return area
+}
+
+const px = (value: number) => `${Math.round(value * 10) / 10}px`
+
+/**
+ * The layer itself, as the marker plugin's view: a fixed box over the visible
+ * part of the editor, one child per frame. Redrawn right away when the ranges
+ * change and on the next frame after any other update, scroll or resize; the
+ * frame elements are reused so the shimmer does not restart while scrolling.
+ */
+export class AiBusyFrames implements PluginView {
+  private readonly layer: HTMLDivElement
+  private frame = 0
+  private readonly redraw = (): void => this.schedule()
+  private readonly resizes: ResizeObserver | null
+
+  constructor(
+    private view: EditorView,
+    private readonly rangesOf: (state: EditorState) => AiBusyRange[],
+  ) {
+    this.layer = document.createElement('div')
+    this.layer.className = 'ai-busy-layer'
+    this.layer.setAttribute('aria-hidden', 'true')
+    document.body.append(this.layer)
+    document.addEventListener('scroll', this.redraw, { capture: true, passive: true })
+    window.addEventListener('resize', this.redraw)
+    this.resizes = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(this.redraw)
+    this.resizes?.observe(view.dom)
+    this.draw()
+  }
+
+  update(view: EditorView, previous: EditorState): void {
+    this.view = view
+    if (this.rangesOf(view.state) !== this.rangesOf(previous)) this.draw()
+    else this.schedule()
+  }
+
+  destroy(): void {
+    cancelAnimationFrame(this.frame)
+    document.removeEventListener('scroll', this.redraw, { capture: true })
+    window.removeEventListener('resize', this.redraw)
+    this.resizes?.disconnect()
+    this.layer.remove()
+  }
+
+  private schedule(): void {
+    if (this.frame || this.rangesOf(this.view.state).length === 0) return
+    this.frame = requestAnimationFrame(() => {
+      this.frame = 0
+      this.draw()
+    })
+  }
+
+  private draw(): void {
+    const ranges = this.rangesOf(this.view.state)
+    const frames = ranges.flatMap((range) =>
+      framesOf(measure(this.view, range)).map((box, i) => ({
+        box,
+        label: i === 0 ? range.label : undefined,
+      })),
+    )
+    const area = visibleArea(this.view.dom)
+    Object.assign(this.layer.style, {
+      top: px(area.top),
+      left: px(area.left),
+      width: px(Math.max(0, area.right - area.left)),
+      height: px(Math.max(0, area.bottom - area.top)),
+    })
+    this.layer.classList.toggle('dark', this.view.dom.closest('.page-dark') !== null)
+    frames.forEach(({ box, label }, i) => this.paint(this.frameAt(i), box, area, label))
+    Array.from(this.layer.children)
+      .slice(frames.length)
+      .forEach((el) => {
+        ;(el as HTMLElement).hidden = true
+      })
+  }
+
+  private frameAt(i: number): HTMLElement {
+    const existing = this.layer.children[i] as HTMLElement | undefined
+    if (existing) return existing
+    const el = document.createElement('div')
+    el.className = 'ai-busy-frame'
+    this.layer.append(el)
+    return el
+  }
+
+  private paint(el: HTMLElement, box: Box, area: Box, label: string | undefined): void {
+    el.hidden = false
+    Object.assign(el.style, {
+      top: px(box.top - area.top),
+      left: px(box.left - area.left),
+      width: px(box.right - box.left),
+      height: px(box.bottom - box.top),
+    })
+    const tag = el.firstElementChild as HTMLElement | null
+    if (!label) {
+      tag?.remove()
+      return
+    }
+    const shown = tag ?? el.appendChild(document.createElement('span'))
+    shown.className = 'ai-busy-label'
+    shown.textContent = label
+  }
+}

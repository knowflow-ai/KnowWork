+/** @vitest-environment jsdom */
+/** With a host owning the AI, the sidebar switch reads off and closes an open panel. */
+import { act, createElement, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+import { expect, it, vi } from 'vitest'
+
+vi.mock('../src/host-ai', () => ({ hostOwnsAi: () => true }))
+
+const { applyAiPanelPrefs, useAiSidebarEnabled } = await import('../src/ai-panel-prefs-store')
+
+it('turns the sidebar off when an embedding page owns the AI', () => {
+  vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true)
+  applyAiPanelPrefs({ showAiSidebar: true })
+  function Dock() {
+    const [open, setOpen] = useState(true)
+    const enabled = useAiSidebarEnabled(setOpen)
+    return createElement('div', { 'data-open': String(open), 'data-enabled': String(enabled) })
+  }
+  const host = document.createElement('div')
+  document.body.append(host)
+  const root = createRoot(host)
+  act(() => root.render(createElement(Dock)))
+  const dock = host.firstElementChild as HTMLElement
+  expect(dock.dataset.enabled).toBe('false')
+  expect(dock.dataset.open).toBe('false')
+  act(() => root.unmount())
+})
diff --git a/packages/ui/tests/host-ai.test.ts b/packages/ui/tests/host-ai.test.ts

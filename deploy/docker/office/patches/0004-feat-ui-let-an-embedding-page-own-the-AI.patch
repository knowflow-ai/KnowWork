+import { webTabById } from '../../web/tab-registry'
+
+/**
+ * An agent's call changed the document open in this tab (an MCP edit tool
+ * reported it mutated or applied). A browser tab embedded in a host page
+ * (web-server mode under KnowWork) passes it on to the host (web:agent-edited,
+ * shim/host-page.ts), which marks the blocks its agent is about to rewrite and
+ * can take the mark down as soon as the edit lands instead of at the end of the
+ * agent's turn — a slow or second-guessing agent otherwise leaves "AI at work"
+ * over text that is already rewritten. Desktop windows have no host page:
+ * nothing is sent there.
+ */
+export function tellAgentEdited(wcId: number): void {
+  webTabById(wcId)?.send('web:agent-edited')
+}

diff --git a/apps/shell/src/web/embedded-files.ts b/apps/shell/src/web/embedded-files.ts
new file mode 100644
index 00000000..55b1ce53
--- /dev/null
+++ b/apps/shell/src/web/embedded-files.ts
@@ -0,0 +1,330 @@
+import { randomBytes } from 'node:crypto'
+import { createReadStream, existsSync, statSync } from 'node:fs'
+import { mkdir, mkdtemp, readdir, readFile, rm, stat, writeFile } from 'node:fs/promises'
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import { tmpdir } from 'node:os'
+import { basename, extname, join, sep } from 'node:path'
+import type { OpenDialogOptions, SaveDialogOptions } from 'electron'
+import type { WebTabContents } from './web-contents'
+
+/**
+ * File dialogs of a browser tab embedded in a host page (KnowWork).
+ *
+ * The web-server dialogs browse the server's own disk, which is right when the
+ * person in the browser owns that machine. An embedded editor runs on a
+ * machine its user does not own (a per-person container, or a shared host):
+ * its directories are none of the user's business, and a file exported there
+ * never reaches them. So for an embedded tab the dialogs land on the user's
+ * own computer instead:
+ * - save (Export PDF, Save As, Save Picture): the app writes into a private
+ *   temp folder, and once the file is written the tab downloads it through a
+ *   one-time URL;
+ * - open (Insert Picture, Open): the tab shows the browser's file picker and
+ *   uploads the chosen files into a private temp folder, whose paths go back to
+ *   the app;
+ * - open a folder (Export as Images, mail merge into files): GenOffice only
+ *   asks for a folder to write an export into, so this is a save as well: the
+ *   app writes into a private temp folder, and once nothing has changed for a
+ *   few seconds one file downloads as it is and several as one zip.
+ * Both URLs sit behind the same token cookie as everything else.
+ */
+
+const EXPORT_PREFIX = '/__web/export/'
+const UPLOAD_PREFIX = '/__web/upload/'
+const MAX_UPLOAD_BYTES = 200 * 1024 * 1024
+const WRITE_POLL_MS = 250
+const WRITE_WAIT_MS = 10 * 60_000
+const EXPORT_TTL_MS = 10 * 60_000
+/** a folder export is done when nothing in it has changed for this long */
+const FOLDER_QUIET_MS = 4_000
+
+/** whether a tab is embedded in a host page (its URL names the host, `?host=`) */
+export function isEmbeddedTab(tab: { url: string }): boolean {
+  try {
+    return Boolean(new URL(tab.url, 'http://localhost').searchParams.get('host'))
+  } catch {
+    return false
+  }
+}
+
+// ---- save: write privately, then download ----
+
+const exports = new Map<string, { path: string; name: string; expires: number }>()
+/** files written for a download: an app "opening what it just exported" has nothing to do for them */
+const downloads = new Set<string>()
+
+/** an export the tab downloads (or a file in such a folder); the shell skips opening it (it would reveal the editor machine's file) */
+export function deliveredAsDownload(path: string): boolean {
+  if (downloads.has(path)) return true
+  for (const target of downloads) if (path.startsWith(target + sep)) return true
+  return false
+}
+
+/** hand a written file to the tab as a one-time download; `done` cleans up after it expires */
+function offerDownload(tab: WebTabContents, path: string, name: string, done: () => void): void {
+  const token = randomBytes(18).toString('base64url')
+  exports.set(token, { path, name, expires: Date.now() + EXPORT_TTL_MS })
+  setTimeout(() => {
+    exports.delete(token)
+    done()
+  }, EXPORT_TTL_MS).unref()
+  tab.deliver('web:download', [{ url: `${EXPORT_PREFIX}${token}`, name }])
+}
+
+function fileNameOf(options: SaveDialogOptions): string {
+  const given = basename(String(options.defaultPath ?? '')).trim()
+  const ext = options.filters?.[0]?.extensions?.find((e) => e && e !== '*')
+  const name = given || 'export'
+  return extname(name) || !ext ? name : `${name}.${ext}`
+}
+
+/** wait until the app has written the file (it appears and its size settles) */
+async function written(path: string): Promise<boolean> {
+  const deadline = Date.now() + WRITE_WAIT_MS
+  let last = -1
+  while (Date.now() < deadline) {
+    await new Promise((r) => setTimeout(r, WRITE_POLL_MS))
+    const size = await stat(path).then(
+      (s) => s.size,
+      () => -1,
+    )
+    if (size > 0 && size === last) return true
+    last = size
+  }
+  return false
+}
+
+export async function embeddedSave(
+  tab: WebTabContents,
+  options: SaveDialogOptions,
+): Promise<{ canceled: boolean; filePath?: string }> {
+  const dir = await mkdtemp(join(tmpdir(), 'genoffice-export-'))
+  const name = fileNameOf(options)
+  const filePath = join(dir, name)
+  downloads.add(filePath)
+  const forget = () => {
+    downloads.delete(filePath)
+    void rm(dir, { recursive: true, force: true })
+  }
+  void written(filePath).then((ok) => {
+    if (!ok || tab.isDestroyed()) forget()
+    else offerDownload(tab, filePath, name, forget)
+  })
+  return { canceled: false, filePath }
+}
+
+// ---- open a folder: an export target, downloaded as one file or one zip ----
+
+/** the files written into the folder so far (half-written atomic-write temps and hidden files left out) */
+async function filesIn(dir: string): Promise<{ path: string; name: string; size: number }[]> {
+  const names = await readdir(dir).catch(() => [] as string[])
+  const files = await Promise.all(
+    names
+      .filter((name) => !name.startsWith('.') && !name.endsWith('.tmp'))
+      .sort()
+      .map(async (name) => {
+        const info = await stat(join(dir, name)).catch(() => null)
+        return info?.isFile() ? { path: join(dir, name), name, size: info.size } : null
+      }),
+  )
+  return files.filter((file) => file !== null)
+}
+
+/** wait until the app has written its export into the folder: files there, nothing changing for a while */
+async function folderSettled(dir: string, quietMs: number): Promise<string[]> {
+  const deadline = Date.now() + WRITE_WAIT_MS
+  let signature = ''
+  let quietSince = Date.now()
+  while (Date.now() < deadline) {
+    await new Promise((r) => setTimeout(r, WRITE_POLL_MS))
+    const files = await filesIn(dir)
+    const now = files.map((file) => `${file.name}:${file.size}`).join('|')
+    if (now !== signature) {
+      signature = now
+      quietSince = Date.now()
+    } else if (files.length > 0 && Date.now() - quietSince >= quietMs) {
+      return files.map((file) => file.path)
+    }
+  }
+  return []
+}
+
+/** the name of the document the tab shows, without its extension (names the zip) */
+function documentStem(tab: WebTabContents): string {
+  let path: string
+  try {
+    path = new URL(tab.url, 'http://localhost').searchParams.get('path') ?? ''
+  } catch {
+    path = ''
+  }
+  const name = basename(path)
+  return (name ? name.slice(0, name.length - extname(name).length) : '') || 'export'
+}
+
+export async function embeddedFolder(
+  tab: WebTabContents,
+  quietMs = FOLDER_QUIET_MS,
+): Promise<{ canceled: boolean; filePaths: string[] }> {
+  const root = await mkdtemp(join(tmpdir(), 'genoffice-export-'))
+  const dir = join(root, 'files')
+  await mkdir(dir)
+  downloads.add(dir)
+  const forget = () => {
+    downloads.delete(dir)
+    void rm(root, { recursive: true, force: true })
+  }
+  void folderSettled(dir, quietMs).then(async (files) => {
+    if (files.length === 0 || tab.isDestroyed()) return forget()
+    if (files.length === 1) return offerDownload(tab, files[0], basename(files[0]), forget)
+    const { default: JSZip } = await import('jszip')
+    const zip = new JSZip()
+    for (const file of files) zip.file(basename(file), await readFile(file))
+    const name = `${documentStem(tab)}.zip`
+    const zipPath = join(root, name)
+    await writeFile(zipPath, await zip.generateAsync({ type: 'nodebuffer' }))
+    offerDownload(tab, zipPath, name, forget)
+  })
+  return { canceled: false, filePaths: [dir] }
+}
+
+// ---- open: browser picker, upload, then the app gets the uploaded paths ----
+
+interface Pick {
+  readonly tab: WebTabContents
+  readonly dir: string
+  readonly files: string[]
+  readonly resolve: (result: { canceled: boolean; filePaths: string[] }) => void
+}
+
+const picks = new Map<string, Pick>()
+
+export async function embeddedOpen(
+  tab: WebTabContents,
+  options: OpenDialogOptions,
+): Promise<{ canceled: boolean; filePaths: string[] }> {
+  // GenOffice asks for a folder only to write an export into it (checked: Export as
+  // Images, mail merge into files): that is a save, not a file from the user
+  if ((options.properties ?? []).includes('openDirectory')) return embeddedFolder(tab)
+  const id = randomBytes(12).toString('base64url')
+  const dir = await mkdtemp(join(tmpdir(), 'genoffice-upload-'))
+  const accept = (options.filters ?? [])
+    .flatMap((f) => f.extensions)
+    .filter((e) => e && e !== '*')
+    .map((e) => `.${e}`)
+  const multiple = (options.properties ?? []).includes('multiSelections')
+  return new Promise((resolve) => {
+    const timer = setTimeout(() => finish(id, true), WRITE_WAIT_MS)
+    timer.unref()
+    picks.set(id, {
+      tab,
+      dir,
+      files: [],
+      resolve: (result) => {
+        clearTimeout(timer)
+        resolve(result)
+      },
+    })
+    tab.deliver('web:pick', [{ url: `${UPLOAD_PREFIX}${id}`, accept: accept.join(','), multiple }])
+  })
+}
+
+function finish(id: string, canceled: boolean): void {
+  const pick = picks.get(id)
+  if (!pick) return
+  picks.delete(id)
+  if (canceled || pick.files.length === 0) {
+    void rm(pick.dir, { recursive: true, force: true })
+    pick.resolve({ canceled: true, filePaths: [] })
+  } else {
+    pick.resolve({ canceled: false, filePaths: [...pick.files] })
+  }
+}
+
+/** a closed tab can never finish its pick */
+export function cancelPicksFor(tab: WebTabContents): void {
+  for (const [id, pick] of [...picks]) if (pick.tab === tab) finish(id, true)
+}
+
+async function readBody(req: IncomingMessage): Promise<Buffer | null> {
+  const chunks: Buffer[] = []
+  let size = 0
+  for await (const chunk of req) {
+    size += chunk.length
+    if (size > MAX_UPLOAD_BYTES) return null
+    chunks.push(chunk as Buffer)
+  }
+  return Buffer.concat(chunks)
+}
+
+/** the picked file's own name (the query string is already decoded): no folders, no control characters */
+function safeName(raw: string | undefined): string {
+  const name = [...basename((raw ?? '').replace(/\\/g, '/'))]
+    .filter((ch) => ch.charCodeAt(0) >= 32)
+    .join('')
+    .trim()
+  return name && name !== '.' && name !== '..' ? name.slice(0, 200) : 'file'
+}
+
+// ---- HTTP ----
+
+/** serve the export downloads and the uploads; false when the request is not one of them */
+export async function serveEmbeddedFiles(
+  req: IncomingMessage,
+  res: ServerResponse,
+  opts: { authorized: (req: IncomingMessage) => boolean },
+): Promise<boolean> {
+  const pathname = new URL(req.url ?? '/', 'http://localhost').pathname
+  const isExport = pathname.startsWith(EXPORT_PREFIX)
+  const isUpload = pathname.startsWith(UPLOAD_PREFIX)
+  if (!isExport && !isUpload) return false
+  if (!opts.authorized(req)) {
+    res.writeHead(401)
+    res.end('unauthorized')
+    return true
+  }
+  if (isExport) {
+    const entry = exports.get(pathname.slice(EXPORT_PREFIX.length))
+    if (req.method !== 'GET' || !entry || entry.expires < Date.now() || !existsSync(entry.path)) {
+      res.writeHead(404)
+      res.end('gone')
+      return true
+    }
+    res.writeHead(200, {
+      'content-type': 'application/octet-stream',
+      'content-length': String(statSync(entry.path).size),
+      'content-disposition': `attachment; filename*=UTF-8''${encodeURIComponent(entry.name)}`,
+      'cache-control': 'no-store',
+    })
+    createReadStream(entry.path).pipe(res)
+    return true
+  }
+  const search = new URL(req.url ?? '/', 'http://localhost').searchParams
+  const id = pathname.slice(UPLOAD_PREFIX.length)
+  const pick = picks.get(id)
+  if (req.method !== 'POST' || !pick) {
+    res.writeHead(404)
+    res.end('gone')
+    return true
+  }
+  if (search.get('done') !== null || search.get('cancel') !== null) {
+    finish(id, search.get('cancel') !== null)
+    res.writeHead(204)
+    res.end()
+    return true
+  }
+  const body = await readBody(req)
+  if (body === null) {
+    res.writeHead(413)
+    res.end('too large')
+    return true
+  }
+  // each file in its own folder, under the name the user picked (the app may show or keep it)
+  const folder = join(pick.dir, String(pick.files.length))
+  await mkdir(folder, { recursive: true })
+  const target = join(folder, safeName(search.get('name') ?? undefined))
+  await writeFile(target, body)
+  pick.files.push(target)
+  res.writeHead(204)
+  res.end()
+  return true
+}

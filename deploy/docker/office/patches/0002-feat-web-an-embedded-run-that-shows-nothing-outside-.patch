+} from '../src/web/embedded-files'
+import { installWebDialogPatch, runWithWebDispatch } from '../src/web/web-dialogs'
+import { WebTabContents } from '../src/web/web-contents'
+
+const TOKEN = 't'.repeat(48)
+const EMBEDDED = '/docs/?path=%2Fwork%2Fc1%2Fa.docx&host=https%3A%2F%2Fkw.example.com'
+
+function embeddedTab(url = EMBEDDED) {
+  const tab = new WebTabContents(url)
+  const delivered: [string, Record<string, unknown>][] = []
+  tab.deliver = (channel, args) => delivered.push([channel, args[0] as Record<string, unknown>])
+  return { tab, delivered }
+}
+
+let server: Server | undefined
+async function serve(): Promise<{ base: string; cookie: string }> {
+  server = createServer((req, res) => {
+    const authorized = (r: { headers: { cookie?: string } }) =>
+      (r.headers.cookie ?? '').includes(`kw_test=${TOKEN}`)
+    void serveEmbeddedFiles(req, res, { authorized }).then((served) => {
+      if (!served) {
+        res.writeHead(418)
+        res.end()
+      }
+    })
+  })
+  await new Promise<void>((r) => server!.listen(0, '127.0.0.1', r))
+  const port = (server.address() as AddressInfo).port
+  return { base: `http://127.0.0.1:${port}`, cookie: `kw_test=${TOKEN}` }
+}
+
+const until = async (check: () => boolean, ms = 3000) => {
+  const deadline = Date.now() + ms
+  while (!check() && Date.now() < deadline) await new Promise((r) => setTimeout(r, 50))
+}
+
+describe('embedded file dialogs (files go to and come from the user, not the server disk)', () => {

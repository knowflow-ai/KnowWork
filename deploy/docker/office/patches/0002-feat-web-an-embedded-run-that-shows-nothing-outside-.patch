diff --git a/apps/shell/src/web/saved-watch.ts b/apps/shell/src/web/saved-watch.ts
new file mode 100644
index 00000000..143d071e
--- /dev/null
+++ b/apps/shell/src/web/saved-watch.ts
@@ -0,0 +1,97 @@
+import { watch, type FSWatcher } from 'node:fs'
+import { stat } from 'node:fs/promises'
+import { basename, dirname } from 'node:path'
+
+/**
+ * Tell an embedded browser tab that its document was written to disk
+ * (web-server mode under a host page, KnowWork).
+ *
+ * The host keeps its own copy of the file (a new version per save), so it has
+ * to hear about every write: Save, AutoSave, Save As over the same path, and an
+ * agent's open_documents save. Each family saves through its own channel, so
+ * the one place that sees them all is the file itself. The directory is
+ * watched rather than the file because a save that writes a temp file and
+ * renames it over the original would leave a file watcher on the old inode.
+ * Writes settle for a moment (a save may write in pieces) and the size and
+ * mtime must differ from the last notice, so one save is one notice.
+ */
+
+export const SETTLE_MS = 400
+
+async function stampOf(path: string): Promise<string | null> {
+  try {
+    const info = await stat(path)
+    return info.isFile() ? `${info.mtimeMs}:${info.size}` : null
+  } catch {
+    return null
+  }
+}
+
+/** watch one file; notify() after each settled write. Returns the stop function */
+export async function watchFileSaves(
+  filePath: string,
+  notify: () => void,
+  settleMs = SETTLE_MS,
+): Promise<() => void> {
+  let last = await stampOf(filePath)
+  let timer: ReturnType<typeof setTimeout> | null = null
+  let stopped = false
+  const name = basename(filePath)
+  const check = async (): Promise<void> => {
+    timer = null
+    const now = await stampOf(filePath)
+    if (stopped || now === null || now === last) return
+    last = now
+    notify()
+  }
+  let watcher: FSWatcher
+  try {
+    watcher = watch(dirname(filePath), (_event, changed) => {
+      if (changed && changed.toString() !== name) return
+      if (timer) clearTimeout(timer)
+      timer = setTimeout(() => void check(), settleMs)
+    })
+  } catch {
+    return () => {}
+  }
+  watcher.on('error', () => watcher.close())
+  return () => {
+    stopped = true
+    if (timer) clearTimeout(timer)
+    watcher.close()
+  }
+}
+
+/**
+ * The file a browser tab was opened with, when the tab is embedded in a host
+ * page (`?host=`); other tabs are left alone.
+ */
+export function embeddedTabFile(tabUrl: string): string | null {
+  let url: URL
+  try {
+    url = new URL(tabUrl, 'http://localhost')
+  } catch {
+    return null
+  }
+  const path = url.searchParams.get('path')
+  return path && url.searchParams.get('host') ? path : null
+}
+
+/** start watching an embedded tab's file; deliver('web:saved', [path]) per write */
+export function watchEmbeddedTab(
+  tabUrl: string,
+  deliver: (channel: string, args: unknown[]) => void,
+): () => void {
+  const path = embeddedTabFile(tabUrl)
+  if (!path) return () => {}
+  let stop: (() => void) | null = null
+  let closed = false
+  void watchFileSaves(path, () => deliver('web:saved', [path])).then((fn) => {
+    if (closed) fn()
+    else stop = fn
+  })
+  return () => {
+    closed = true
+    stop?.()
+  }
+}

+++ b/packages/ui/src/host-origin.ts
@@ -0,0 +1,20 @@
+/**
+ * The embedding page's origin when a host owns the AI (KnowWork): the editor's
+ * URL names it (`?host=<origin>`) and the page really is framed by it. No
+ * imports, so the web shim can use it without pulling in host-ai.css.
+ */
+export function hostAiOrigin(win: Window = window): string | null {
+  if (win.parent === win) return null
+  const raw = new URLSearchParams(win.location.search).get('host')
+  if (!raw) return null
+  let origin: string
+  try {
+    origin = new URL(raw).origin
+  } catch {
+    return null
+  }
+  if (origin === 'null') return null
+  const ancestors = (win.location as Location & { ancestorOrigins?: DOMStringList }).ancestorOrigins
+  if (ancestors && ancestors.length > 0 && ancestors[0] !== origin) return null
+  return origin
+}

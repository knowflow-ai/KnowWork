diff --git a/apps/shell/src/web/web-only-dialogs.ts b/apps/shell/src/web/web-only-dialogs.ts
new file mode 100644
index 00000000..93d01e47
--- /dev/null
+++ b/apps/shell/src/web/web-only-dialogs.ts
@@ -0,0 +1,55 @@
+import type { ShowMessage, ShowOpen, ShowSave } from './web-dialogs'
+
+/**
+ * The real Electron dialogs the web dialog patch falls back to outside a
+ * browser-tab dispatch. A web-only run (KnowWork's embedded editor) has no
+ * window of its own: a dialog no browser tab asked for (an error box, a
+ * background check) would pop up as a bare Electron window on the machine, so
+ * there it is answered "cancel" and logged instead.
+ */
+export function nativeDialogs(
+  d: { showSaveDialog: ShowSave; showOpenDialog: ShowOpen; showMessageBox: ShowMessage },
+  webOnly: boolean,
+): { nativeSave: ShowSave; nativeOpen: ShowOpen; nativeMessage: ShowMessage } {
+  if (!webOnly) {
+    return {
+      nativeSave: d.showSaveDialog.bind(d),
+      nativeOpen: d.showOpenDialog.bind(d),
+      nativeMessage: d.showMessageBox.bind(d),
+    }
+  }
+  const unseen = (what: string, text: unknown): void =>
+    console.warn(
+      `[web] web-only run: no ${what} dialog shown (${String(text ?? '').slice(0, 120)})`,
+    )
+  const errorBox = d as unknown as { showErrorBox: (title: string, content: string) => void }
+  errorBox.showErrorBox = (title, content) => unseen('error', `${title}: ${content}`)
+  return {
+    nativeSave: async (options) => (unseen('save', options.title), { canceled: true }),
+    nativeOpen: async (options) => (
+      unseen('open', options.title),
+      { canceled: true, filePaths: [] }
+    ),
+    nativeMessage: async (options) => (
+      unseen('message', options.message),
+      { response: options.cancelId ?? 0 }
+    ),
+  }
+}
+
+/**
+ * A web-only run has no desktop of its own either: revealing a just-exported
+ * file in the file manager, or opening it with a local app, would happen on
+ * the server machine (Finder popping up on a shared host). There those calls
+ * only log.
+ */
+export function silenceShell(
+  shell: { showItemInFolder?: unknown; openPath?: unknown } | undefined,
+  webOnly: boolean,
+): void {
+  if (!webOnly || !shell) return
+  const unseen = (what: string, path: unknown): void =>
+    console.warn(`[web] web-only run: not ${what} on this machine (${String(path ?? '')})`)
+  shell.showItemInFolder = (path: string) => unseen('revealing', path)
+  shell.openPath = async (path: string) => (unseen('opening', path), '')
+}
diff --git a/apps/shell/src/web/web-only.ts b/apps/shell/src/web/web-only.ts
new file mode 100644
index 00000000..5b7005f3
--- /dev/null
+++ b/apps/shell/src/web/web-only.ts
@@ -0,0 +1,11 @@
+/**
+ * Web-service-only runs: an embedding host (a desktop app that frames the
+ * editors, a server that runs one service per user) wants the browser surface
+ * and nothing on screen. `--web-only` / GENOFFICE_WEB_ONLY=1 keeps the shell
+ * window (the tab manager and the main-process handlers still live in it)
+ * but never shows it, and drops the Dock icon on macOS. Only meaningful with
+ * the web server on.
+ */
+export function webOnlyRequested(argv: readonly string[], env: NodeJS.ProcessEnv): boolean {
+  return argv.includes('--web-only') || env.GENOFFICE_WEB_ONLY === '1'
+}

@@ -0,0 +1,90 @@
+/**
+ * Browser side of the embedded file dialogs (../embedded-files.ts): in a tab
+ * embedded in a host page, a saved file is downloaded to the user's computer
+ * and an opened file is picked from it, instead of browsing the server's disk.
+ */
+
+/** the server wrote a file the user asked for (Export PDF, Save As): download it */
+export function downloadFile(request: { url?: unknown; name?: unknown }): void {
+  if (typeof request.url !== 'string' || !request.url.startsWith('/__web/export/')) return
+  const link = document.createElement('a')
+  link.href = request.url
+  link.download = typeof request.name === 'string' ? request.name : ''
+  link.style.display = 'none'
+  document.body.appendChild(link)
+  link.click()
+  link.remove()
+}
+
+const zh = (): boolean => /^zh/i.test(navigator.language || '')
+
+/**
+ * the app asked for files (Insert Picture, Open): the browser's file picker,
+ * each chosen file uploaded, then done (or cancel when nothing was chosen)
+ */
+export function pickFiles(request: { url?: unknown; accept?: unknown; multiple?: unknown }): void {
+  const url = request.url
+  if (typeof url !== 'string' || !url.startsWith('/__web/upload/')) return
+  const input = document.createElement('input')
+  input.type = 'file'
+  input.accept = typeof request.accept === 'string' ? request.accept : ''
+  input.multiple = request.multiple === true
+  input.style.display = 'none'
+  let settled = false
+  let prompt: HTMLElement | null = null
+  const finish = (outcome: 'done' | 'cancel'): void => {
+    if (settled) return
+    settled = true
+    input.remove()
+    prompt?.remove()
+    void fetch(`${url}?${outcome}=1`, { method: 'POST', credentials: 'same-origin' }).catch(
+      () => undefined,
+    )
+  }
+  input.addEventListener('change', () => {
+    const files = [...(input.files ?? [])]
+    if (files.length === 0) return finish('cancel')
+    void (async () => {
+      try {
+        for (const file of files) {
+          const response = await fetch(`${url}?name=${encodeURIComponent(file.name)}`, {
+            method: 'POST',
+            body: file,
+            credentials: 'same-origin',
+          })
+          if (!response.ok) throw new Error(`upload failed: ${response.status}`)
+        }
+        finish('done')
+      } catch {
+        finish('cancel')
+      }
+    })()
+  })
+  input.addEventListener('cancel', () => finish('cancel'))
+  document.body.appendChild(input)
+  // a file picker opens only on a user gesture; the request comes back over
+  // the socket right after the click that asked for it, usually still inside
+  // the gesture's window. When it has passed, ask for one more click.
+  const activation = (navigator as { userActivation?: { isActive: boolean } }).userActivation
+  if (activation === undefined || activation.isActive) {
+    input.click()
+    return
+  }
+  prompt = document.createElement('div')
+  prompt.style.cssText =
+    'position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;' +
+    'background:rgba(0,0,0,.25);font:14px system-ui,sans-serif'
+  const box = document.createElement('div')
+  box.style.cssText =
+    'background:#fff;border-radius:10px;padding:16px 20px;display:flex;gap:12px;align-items:center;' +
+    'box-shadow:0 8px 24px rgba(0,0,0,.18)'
+  const choose = document.createElement('button')
+  choose.textContent = zh() ? '选择文件' : 'Choose file'
+  const cancel = document.createElement('button')
+  cancel.textContent = zh() ? '取消' : 'Cancel'
+  choose.onclick = () => input.click()
+  cancel.onclick = () => finish('cancel')
+  box.append(choose, cancel)
+  prompt.appendChild(box)
+  document.body.appendChild(prompt)
+}

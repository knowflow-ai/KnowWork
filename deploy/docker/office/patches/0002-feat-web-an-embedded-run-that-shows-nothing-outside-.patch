+    expect(isEmbeddedTab({ url: EMBEDDED })).toBe(true)
+    expect(isEmbeddedTab({ url: '/docs/?path=%2Fx.docx' })).toBe(false)
+  })
+
+  it('save: no directory browsing; the written file downloads once through a token-guarded URL', async () => {
+    const { base, cookie } = await serve()
+    const { tab, delivered } = embeddedTab()
+    const result = await embeddedSave(tab, {
+      defaultPath: '/data/someone/设备检修通知',
+      filters: [{ name: 'PDF', extensions: ['pdf'] }],
+    })
+    expect(result.canceled).toBe(false)
+    expect(basename(result.filePath!)).toBe('设备检修通知.pdf')
+    expect(dirname(result.filePath!)).not.toContain('/data/someone')
+    writeFileSync(result.filePath!, '%PDF-1.7 exported')
+    await until(() => delivered.length > 0)
+    const [channel, request] = delivered[0]
+    expect(channel).toBe('web:download')
+    expect(request.name).toBe('设备检修通知.pdf')
+    const url = `${base}${String(request.url)}`
+    expect((await fetch(url)).status).toBe(401)
+    const response = await fetch(url, { headers: { cookie } })
+    expect(response.status).toBe(200)
+    expect(response.headers.get('content-disposition')).toContain(
+      encodeURIComponent('设备检修通知.pdf'),
+    )
+    expect(await response.text()).toBe('%PDF-1.7 exported')
+    expect((await fetch(`${base}/__web/export/made-up`, { headers: { cookie } })).status).toBe(404)
+  })
+
+  it('open: the browser picker uploads the chosen files, the app gets their paths; cancel gives nothing', async () => {
+    const { base, cookie } = await serve()
+    const { tab, delivered } = embeddedTab()
+    const picked = embeddedOpen(tab, {
+      filters: [{ name: 'Images', extensions: ['png', 'jpg'] }],
+      properties: ['openFile'],
+    })
+    await until(() => delivered.length > 0)
+    const [channel, request] = delivered[0]
+    expect(channel).toBe('web:pick')
+    expect(request).toMatchObject({ accept: '.png,.jpg', multiple: false })
+    const url = `${base}${String(request.url)}`
+    expect((await fetch(`${url}?name=x.png`, { method: 'POST', body: 'x' })).status).toBe(401)
+    expect(
+      (
+        await fetch(`${url}?name=${encodeURIComponent('../流程图.png')}`, {
+          method: 'POST',
+          body: 'png-bytes',
+          headers: { cookie },
+        })
+      ).status,
+    ).toBe(204)
+    expect((await fetch(`${url}?done=1`, { method: 'POST', headers: { cookie } })).status).toBe(204)
+    const result = await picked
+    expect(result.canceled).toBe(false)
+    expect(result.filePaths.map((p) => basename(p))).toEqual(['流程图.png'])
+    expect(readFileSync(result.filePaths[0], 'utf8')).toBe('png-bytes')
+
+    const second = embeddedTab()
+    const canceled = embeddedOpen(second.tab, {})
+    await until(() => second.delivered.length > 0)
+    await fetch(`${base}${String(second.delivered[0][1].url)}?cancel=1`, {
+      method: 'POST',
+      headers: { cookie },
+    })
+    await expect(canceled).resolves.toEqual({ canceled: true, filePaths: [] })
+
+    const closed = embeddedTab()
+    const gone = embeddedOpen(closed.tab, {})
+    await until(() => closed.delivered.length > 0)
+    cancelPicksFor(closed.tab)
+    await expect(gone).resolves.toEqual({ canceled: true, filePaths: [] })
+  })
+
+  it('a folder is where an export lands: one file downloads as it is, several as one zip', async () => {
+    const { base, cookie } = await serve()
+    const many = embeddedTab()
+    const target = await embeddedFolder(many.tab, 300)
+    const dir = target.filePaths[0]
+    writeFileSync(`${dir}/设备检修通知-1.png`, 'page-1')
+    writeFileSync(`${dir}/设备检修通知-2.png.ab12cd.tmp`, 'half written')
+    writeFileSync(`${dir}/设备检修通知-2.png`, 'page-2')
+    expect(deliveredAsDownload(`${dir}/设备检修通知-1.png`)).toBe(true)
+    await until(() => many.delivered.length > 0, 5000)
+    const [channel, request] = many.delivered[0]
+    expect(channel).toBe('web:download')
+    expect(request.name).toBe('a.zip')
+    const zipped = await fetch(`${base}${String(request.url)}`, { headers: { cookie } })
+    const { default: JSZip } = await import('jszip')
+    const zip = await JSZip.loadAsync(await zipped.arrayBuffer())
+    expect(Object.keys(zip.files).sort()).toEqual(['设备检修通知-1.png', '设备检修通知-2.png'])
+    expect(await zip.file('设备检修通知-2.png')!.async('string')).toBe('page-2')
+
+    const one = embeddedTab()
+    const single = await embeddedFolder(one.tab, 300)
+    writeFileSync(`${single.filePaths[0]}/合并结果.docx`, 'merged')
+    await until(() => one.delivered.length > 0, 5000)
+    expect(one.delivered[0][1].name).toBe('合并结果.docx')
+  })
+
+  it('an open-folder dialog is an export target, not a file picker', async () => {
+    const { tab, delivered } = embeddedTab()
+    const result = await embeddedOpen(tab, { properties: ['openDirectory', 'createDirectory'] })
+    expect(result.canceled).toBe(false)
+    expect(result.filePaths).toHaveLength(1)
+    expect(delivered.some(([channel]) => channel === 'web:pick')).toBe(false)
+  })
+
+  it('the patched Electron dialogs take this path for embedded tabs only', async () => {
+    installWebDialogPatch()
+    const { dialog } = (await import('electron')) as unknown as {
+      dialog: {
+        showSaveDialog: (
+          first: unknown,
+          second?: unknown,
+        ) => Promise<{ canceled: boolean; filePath?: string }>
+      }
+    }
+    const { tab, delivered } = embeddedTab()
+    const result = await runWithWebDispatch(tab, () =>
+      dialog.showSaveDialog({ defaultPath: 'a.pdf' }),
+    )
+    expect(result.canceled).toBe(false)
+    expect(delivered.some(([channel]) => channel === 'web:dialog')).toBe(false)
+    expect(deliveredAsDownload(result.filePath!)).toBe(true)
+    expect(deliveredAsDownload('/data/someone/a.pdf')).toBe(false)
+    // apps pass the parent window first (showSaveDialog(window, options)): the options still count
+    const parent = { title: 'GenOffice', id: 1 }
+    const exported = await runWithWebDispatch(tab, () =>
+      dialog.showSaveDialog(parent, {
+        defaultPath: '设备检修通知.pdf',
+        filters: [{ name: 'PDF', extensions: ['pdf'] }],
+      }),
+    )
+    expect(basename(exported.filePath!)).toBe('设备检修通知.pdf')
+    const plain = embeddedTab('/docs/?path=%2Fx.docx')
+    void runWithWebDispatch(plain.tab, () =>
+      dialog.showSaveDialog(parent, { title: '导出为 PDF', defaultPath: 'a.pdf' }),
+    )
+    await until(() => plain.delivered.length > 0)
+    expect(plain.delivered[0][0]).toBe('web:dialog')
+    expect(plain.delivered[0][1]).toMatchObject({
+      options: { kind: 'save', title: '导出为 PDF', defaultPath: 'a.pdf' },
+    })
+  })
+})

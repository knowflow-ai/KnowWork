+import { hostAiOrigin } from '../../../../../packages/ui/src/host-origin'
+
+/**
+ * Browser-tab behaviour for an editor embedded in a host page (KnowWork), kept
+ * apart from client.ts so that file only carries the calls.
+ */
+
+/** the connection dropped: tell an embedding host, which brings the editor back
+ *  itself (it may have to restart the service first); true when there is one */
+export function tellHostDisconnected(): boolean {
+  const host = hostAiOrigin(window)
+  if (!host) return false
+  window.parent.postMessage({ type: 'genoffice:disconnected' }, host)
+  return true
+}
+
+/** the document was written to disk (Save, AutoSave, an agent's save; see
+ *  saved-watch.ts): tell an embedding host, which keeps its own copy */
+export function tellHostSaved(path: string): void {
+  const host = hostAiOrigin(window)
+  if (!host || !path) return
+  window.parent.postMessage({ type: 'genoffice:saved', path }, host)
+}
+
+/** window.alert in a browser tab is a blocking native box (an embedding desktop
+ *  app draws it with its own window chrome): show the notice as the page's
+ *  toast instead. confirm/prompt must answer synchronously, so they stay */
+export function installAlertToast(toast: (text: string) => void): void {
+  window.alert = (message?: unknown) => toast(String(message ?? ''))
+}

@@ -0,0 +1,74 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { mkdtemp, rename, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { embeddedTabFile, watchEmbeddedTab, watchFileSaves } from '../src/web/saved-watch'
+
+const SETTLE = 60
+const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
+
+describe('saved watch (an embedding host hears about every write)', () => {
+  let dir = ''
+  afterEach(async () => {
+    if (dir) await rm(dir, { recursive: true, force: true })
+  })
+
+  it('notifies once per settled write, including a temp file renamed over it', async () => {
+    dir = await mkdtemp(join(tmpdir(), 'saved-watch-'))
+    const file = join(dir, 'report.docx')
+    await writeFile(file, 'v1')
+    let notices = 0
+    const stop = await watchFileSaves(file, () => notices++, SETTLE)
+    try {
+      await writeFile(file, 'v2-part')
+      await writeFile(file, 'v2-whole')
+      await wait(SETTLE * 4)
+      expect(notices).toBe(1)
+
+      await writeFile(join(dir, 'other.docx'), 'x')
+      await wait(SETTLE * 4)
+      expect(notices).toBe(1)
+
+      await writeFile(join(dir, '.report.tmp'), 'v3, written elsewhere first')
+      await rename(join(dir, '.report.tmp'), file)
+      await wait(SETTLE * 4)
+      expect(notices).toBe(2)
+    } finally {
+      stop()
+    }
+    await writeFile(file, 'after stop')
+    await wait(SETTLE * 4)
+    expect(notices).toBe(2)
+  })
+
+  it('only watches tabs embedded in a host page', () => {
+    expect(
+      embeddedTabFile('/docs/?path=%2Fwork%2Fc1%2Fa.docx&host=https%3A%2F%2Fkw.example.com'),
+    ).toBe('/work/c1/a.docx')
+    expect(embeddedTabFile('/docs/?path=%2Fwork%2Fc1%2Fa.docx')).toBeNull()
+    expect(embeddedTabFile('/docs/?host=https%3A%2F%2Fkw.example.com')).toBeNull()
+    const delivered: unknown[][] = []
+    const stop = watchEmbeddedTab('/docs/?path=%2Fnowhere%2Fa.docx', (channel, args) =>
+      delivered.push([channel, ...args]),
+    )
+    stop()
+    expect(delivered).toEqual([])
+  })
+
+  it('delivers web:saved with the path for an embedded tab', async () => {
+    dir = await mkdtemp(join(tmpdir(), 'saved-watch-'))
+    const file = join(dir, 'deck.pptx')
+    await writeFile(file, 'v1')
+    const delivered: unknown[][] = []
+    const url = `/slides/?path=${encodeURIComponent(file)}&host=${encodeURIComponent('https://kw.example.com')}`
+    const stop = watchEmbeddedTab(url, (channel, args) => delivered.push([channel, ...args]))
+    try {
+      await wait(SETTLE)
+      await writeFile(file, 'v2')
+      await wait(1000)
+      expect(delivered).toEqual([['web:saved', file]])
+    } finally {
+      stop()
+    }
+  })
+})

index 00000000..eb95920f
--- /dev/null
+++ b/apps/shell/tests/web-open-documents.test.ts
@@ -0,0 +1,124 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const fromId = vi.fn()
+vi.mock('electron', () => ({
+  session: { defaultSession: {} },
+  webContents: { fromId: (id: number) => fromId(id) },
+}))
+const teardownDocsRenderer = vi.fn()
+vi.mock('../../docs/src/main/docs-main', () => ({
+  docsQueryDirty: vi.fn(async () => true),
+  teardownDocsRenderer: (contents: { id: number }) => teardownDocsRenderer(contents.id),
+}))
+vi.mock('../../sheets/src/main/sheets-main', () => ({
+  sheetsPendingEditCount: vi.fn(() => 0),
+}))
+vi.mock('../../slides/src/main/slides-main', () => ({ slidesIsDirty: vi.fn(() => false) }))
+vi.mock('../../pdf/src/main/pdf-main', () => ({ pdfIsDirty: vi.fn(() => false) }))
+vi.mock('../../markdown/src/main/markdown-main', () => ({ markdownIsDirty: vi.fn(() => false) }))
+vi.mock('../../html/src/main/html-main', () => ({ htmlIsDirty: vi.fn(() => false) }))
+
+import { registerWebTab, unregisterWebTab, WebTabContents } from '../src/web/web-contents'
+import {
+  closeWebTab,
+  isWebTabId,
+  webOpenDocuments,
+  webTabContentsFor,
+} from '../src/web/open-documents'
+import { contentsById } from '../src/main/mcp/contents-by-id'
+
+const opened: WebTabContents[] = []
+function open(url: string): WebTabContents {
+  const tab = new WebTabContents(url)
+  registerWebTab(tab)
+  opened.push(tab)
+  return tab
+}
+
+afterEach(() => {
+  for (const tab of opened.splice(0)) unregisterWebTab(tab)
+  fromId.mockReset()
+})
+
+describe('closing a browser tab from the server', () => {
+  it('tears the Docs session down, drops the tab from the list and tells the page to reload', async () => {
+    const doc = open(`/docs/?path=${encodeURIComponent('/work/报告.docx')}`)
+    const delivered: string[] = []
+    doc.deliver = (channel) => delivered.push(channel)
+    const [listed] = await webOpenDocuments()
+    expect(closeWebTab(listed?.id ?? '')).toBe(true)
+    expect(teardownDocsRenderer).toHaveBeenCalledWith(doc.id)
+    expect(delivered).toEqual(['web:closed'])
+    expect(doc.isDestroyed()).toBe(true)
+    expect(await webOpenDocuments()).toEqual([])
+    expect(closeWebTab(listed?.id ?? '')).toBe(false)
+    expect(closeWebTab('3')).toBe(false)
+  })
+
+  it('a sheet has no Docs teardown', async () => {
+    teardownDocsRenderer.mockClear()
+    const sheet = open('/sheets/?path=/work/a.xlsx')
+    sheet.deliver = () => undefined
+    const [listed] = await webOpenDocuments()
+    expect(closeWebTab(listed?.id ?? '')).toBe(true)
+    expect(teardownDocsRenderer).not.toHaveBeenCalled()
+  })
+})
+
+describe('browser tabs as open documents', () => {
+  it('lists editor tabs with their path, kind and dirtiness', async () => {
+    const doc = open(`/docs/?path=${encodeURIComponent('/work/files/报告.docx')}`)
+    const sheet = open('/sheets/?path=/work/files/a.xlsx')
+    open('/') // the home page is not a document
+    const docs = await webOpenDocuments()
+    expect(docs).toEqual([
+      {
+        id: `web:${doc.id}`,
+        kind: 'docs',
+        title: '报告.docx',
+        filePath: '/work/files/报告.docx',
+        active: false,
+        dirty: true,
+      },
+      {
+        id: `web:${sheet.id}`,
+        kind: 'sheets',
+        title: 'a.xlsx',
+        filePath: '/work/files/a.xlsx',
+        active: false,
+        dirty: false,
+      },
+    ])
+  })
+
+  it('skips tabs that already went away', async () => {
+    const tab = open('/docs/?path=/work/files/x.docx')
+    tab.destroy()
+    expect(await webOpenDocuments()).toEqual([])
+    expect(webTabContentsFor(`web:${tab.id}`)).toBeUndefined()
+  })
+
+  it('resolves only its own ids', () => {
+    const tab = open('/slides/?path=/work/files/d.pptx')
+    expect(isWebTabId(`web:${tab.id}`)).toBe(true)
+    expect(isWebTabId('detached:3')).toBe(false)
+    expect(webTabContentsFor(`web:${tab.id}`)).toBe(tab)
+    expect(webTabContentsFor('3')).toBeUndefined()
+  })
+})
+
+describe('MCP bridge lookup', () => {
+  it('finds a browser tab that Electron does not know', () => {
+    const tab = open('/docs/?path=/work/files/x.docx')
+    expect(contentsById(tab.id)).toBe(tab)
+    expect(fromId).not.toHaveBeenCalled()
+  })
+
+  it('falls back to Electron views', () => {
+    const view = { id: 7 }
+    fromId.mockReturnValue(view)
+    expect(contentsById(7)).toBe(view)
+    fromId.mockReturnValue(null)
+    expect(contentsById(8)).toBeUndefined()
+  })
+})

--- a/apps/docs/src/renderer/ai/revision-author.ts
+++ b/apps/docs/src/renderer/ai/revision-author.ts
@@ -1,6 +1,33 @@
 import { authorName } from '../author-name'
 
-/** AI edits are attributed to the Settings user name, as Word does for add-in edits */
+let override: string | null = null
+
+/**
+ * AI edits are attributed to the Settings user name, as Word does for add-in
+ * edits, unless an external agent names its own author for the command it is
+ * running (withAiRevisionAuthor).
+ */
 export function aiRevisionAuthor(): string {
-  return authorName()
+  return override ?? authorName()
+}
+
+/** the author the running external command named, if any */
+export function aiRevisionAuthorOverride(): string | null {
+  return override
+}
+
+/**
+ * Run `fn` with AI revisions and comments attributed to `name`: a host that
+ * drives the editor over MCP shows its agent as an author of its own
+ * ("Zhang San (AI)") next to the person ("Zhang San"). The bridge runs one
+ * command at a time, so the scope cannot leak into another command.
+ */
+export async function withAiRevisionAuthor<T>(name: string, fn: () => Promise<T>): Promise<T> {
+  const previous = override
+  override = name
+  try {
+    return await fn()
+  } finally {
+    override = previous
+  }
 }
diff --git a/apps/docs/src/renderer/mcp-agent-commands.ts b/apps/docs/src/renderer/mcp-agent-commands.ts
new file mode 100644
index 00000000..ee9fdd97
--- /dev/null
+++ b/apps/docs/src/renderer/mcp-agent-commands.ts
@@ -0,0 +1,228 @@
+import type { Node as PmNode } from '@tiptap/pm/model'
+import type { Editor } from '@tiptap/react'
+import type { McpAgentCommand } from '../shared/mcp-agent'
+import type { NumIds } from './ai/protocol'
+import {
+  withAiRevisionAuthor,
+  aiRevisionAuthor,
+  aiRevisionAuthorOverride,
+} from './ai/revision-author'
+import { AGENT_TOOLS, executeTool, markDocSeen } from './ai/tools'
+import { TABLE_TRAILING_SKIP } from './editor/extensions'
+
+/**
+ * MCP commands for an external agent that drives the open document the way the
+ * in-app assistant does (KnowWork). Kept in its own file: the MCP bridge only
+ * forwards the commands it does not know here, so following upstream changes to
+ * mcp-bridge.ts stays a matter of one forwarding line.
+ *
+ * - list_tools / run_tool: the built-in document tools (block edits, revisions,
+ *   comments, notes, headers/footers, page setup, styles, tables) with the same
+ *   executor, stores and stale-index guard as the in-app assistant; `track: true`
+ *   records the edit as a tracked revision even while Track Changes is off;
+ * - save_checkpoint / restore_checkpoint: whole-document rollback points, the
+ *   external counterpart of the assistant panel's per-turn snapshot;
+ * - `author` on any command: the name its revisions and comments go under.
+ */
+
+type ExecuteToolArgs = Parameters<typeof executeTool>
+
+/** what the built-in agent hands its executors besides the editor (see createDocsSkill) */
+export interface McpEditorAccess {
+  track?: ExecuteToolArgs[3]
+  comments?: ExecuteToolArgs[6]
+  hf?: ExecuteToolArgs[7]
+  pageSetup?: ExecuteToolArgs[9]
+  extras?: ExecuteToolArgs[10]
+  notes?: ExecuteToolArgs[11]
+}
+
+/**
+ * Built-in tools run_tool does not offer: the ones that reach GenOffice's own
+ * model or network (search, image generation, media analysis, image download),
+ * the panel-owned streaming writer, new-file creation, the mind-map card, and
+ * replace_selection (an external agent cannot know where the user's live
+ * selection has wandered; it addresses blocks by index instead).
+ */
+const RUN_TOOL_EXCLUDED = new Set([
+  'web_search',
+  'image_search',
+  'analyze_media',
+  'generate_image',
+  'insert_image',
+  'write_document',
+  'create_document',
+  'generate_mindmap',
+  'replace_selection',
+])
+
+/** rollback points kept per document; the oldest goes first */
+const CHECKPOINT_MAX = 20
+
+/** the document itself, not a JSON copy: it is immutable, so a kept point shares every unchanged
+ *  node with the live one (the agent saves a point per document every turn) */
+const checkpointsByEditor = new WeakMap<Editor, Map<string, PmNode>>()
+
+/** the built-in tool definitions an external agent may call through run_tool */
+export function externalToolDefs(): { name: string; description: string; inputSchema: unknown }[] {
+  return AGENT_TOOLS.filter((tool) => !RUN_TOOL_EXCLUDED.has(tool.name)).map((tool) => ({
+    name: tool.name,
+    description: tool.description,
+    inputSchema: tool.inputSchema,
+  }))
+}
+
+/**
+ * Auto-accept the external edit's "changed by AI" highlight, keeping undo
+ * history: a copy of mcp-bridge.ts's clearAiChangedFlags (itself a mirror of
+ * AiPanel's clearAiHighlights), so the upstream file need not export it.
+ */
+function clearAiChangedFlags(editor: Editor): void {
+  const view = editor.view
+  let tr = view.state.tr
+  let touched = false
+  view.state.doc.forEach((node, offset) => {
+    if (node.attrs.aiChanged) {
+      tr = tr.setNodeMarkup(offset, undefined, { ...node.attrs, aiChanged: false })
+      touched = true
+    }
+  })
+  if (!touched) return
+  tr = tr.setMeta('addToHistory', false)
+  view.dispatch(tr)
+  markDocSeen(editor)
+}
+
+/** the executors are shared with the in-app agent, whose re-read tool has another name on MCP */
+function mcpErrorText(output: string): string {
+  return output.replaceAll('get_document_context', 'read_document')
+}
+
+/** `author` on any command: the name its revisions and comments are recorded under */
+export function commandAuthor(payload: unknown): string | null {
+  const raw = (payload as { author?: unknown } | null)?.author
+  if (typeof raw !== 'string') return null
+  const name = raw.trim()
+  return name ? name.slice(0, 255) : null
+}
+
+/** run one bridge command under the author it names (if any) */
+export function withCommandAuthor<T>(payload: unknown, run: () => Promise<T>): Promise<T> {
+  const author = commandAuthor(payload)
+  return author ? withAiRevisionAuthor(author, run) : run()
+}
+
+function checkpointId(payload: unknown): string {
+  const id = (payload as { id?: unknown } | null)?.id
+  if (typeof id !== 'string' || !id.trim()) throw new Error('a checkpoint needs an "id"')
+  return id.trim()
+}
+
+function checkpointsOf(editor: Editor): Map<string, PmNode> {
+  let checkpoints = checkpointsByEditor.get(editor)
+  if (!checkpoints) {
+    checkpoints = new Map<string, PmNode>()
+    checkpointsByEditor.set(editor, checkpoints)
+  }
+  return checkpoints
+}
+
+function saveCheckpoint(editor: Editor, id: string): void {
+  const checkpoints = checkpointsOf(editor)
+  checkpoints.delete(id)
+  checkpoints.set(id, editor.state.doc)
+  while (checkpoints.size > CHECKPOINT_MAX) {
+    const oldest = checkpoints.keys().next().value as string
+    checkpoints.delete(oldest)
+  }
+}
+
+function restoreCheckpoint(editor: Editor, id: string): void {
+  const checkpoints = checkpointsOf(editor)
+  const snapshot = checkpoints.get(id)
+  if (snapshot === undefined)
+    throw new Error(`no checkpoint "${id}" (kept: the last ${CHECKPOINT_MAX})`)
+  // same rewind as the AI panel's rollback; it is one undoable step, and the
+  // changed document makes the agent re-read before its next indexed write
+  editor.chain().setMeta(TABLE_TRAILING_SKIP, true).setContent(snapshot.toJSON()).run()
+  // restoring rewinds every later point too: they describe a discarded future
+  let later = false
+  for (const key of [...checkpoints.keys()]) {
+    if (later) checkpoints.delete(key)
+    if (key === id) later = true
+  }
+}
+
+/** run one built-in tool with the same stores the in-app agent gets */
+function runTool(
+  editor: Editor,
+  numIds: NumIds,
+  access: McpEditorAccess,
+  name: string,
+  input: Record<string, unknown>,
+  forceTrack: boolean,
+): ReturnType<typeof executeTool> {
+  // a command may name its own author; otherwise the one App resolved. forceTrack
+  // records the edit as a revision even while the document's Track Changes is off
+  const named = aiRevisionAuthorOverride()
+  const track =
+    access.track || forceTrack
+      ? { author: named ?? access.track?.author ?? aiRevisionAuthor() }
+      : undefined
+  return executeTool(
+    editor,
+    { id: 'mcp', name, input },
+    numIds,
+    track,
+    undefined,
+    null,
+    access.comments,
+    access.hf,
+    undefined,
+    access.pageSetup,
+    access.extras,
+    access.notes,
+  )
+}
+
+/** handle an agent command (the bridge routes them here with isAgentCommand) */
+export async function runAgentCommand(
+  command: McpAgentCommand,
+  payload: unknown,
+  editor: Editor,
+  numIds: NumIds,
+  access: McpEditorAccess | null,
+): Promise<unknown> {
+  switch (command) {
+    case 'list_tools':
+      return { tools: externalToolDefs() }
+    case 'run_tool': {
+      const input = (payload ?? {}) as { name?: unknown; input?: unknown; track?: unknown }
+      const name = typeof input.name === 'string' ? input.name : ''
+      if (!AGENT_TOOLS.some((tool) => tool.name === name) || RUN_TOOL_EXCLUDED.has(name)) {
+        throw new Error(`run_tool cannot run "${name}"; list_tools gives the available tools`)
+      }
+      const args =
+        input.input && typeof input.input === 'object'
+          ? (input.input as Record<string, unknown>)
+          : {}
+      const outcome = await runTool(
+        editor,
+        numIds,
+        access ?? {},
+        name,
+        { ...args },
+        input.track === true,
+      )
+      if (outcome.isError) throw new Error(mcpErrorText(outcome.output))
+      if (outcome.mutated) clearAiChangedFlags(editor)
+      return { summary: outcome.summary, output: outcome.output, mutated: outcome.mutated }
+    }
+    case 'save_checkpoint':
+      saveCheckpoint(editor, checkpointId(payload))
+      return { ok: true }
+    case 'restore_checkpoint':
+      restoreCheckpoint(editor, checkpointId(payload))
+      return { ok: true }
+  }
+}

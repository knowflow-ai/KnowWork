+import { z } from 'zod'
+import type { McpToolDefinition } from '../mcp-server'
+import type { DocToolDeps } from './document-tools'
+import type { contentTarget } from './session-tools'
+
+/**
+ * MCP tools for an external agent that drives an open Word document the way
+ * the in-app assistant does (KnowWork): the editor's own document tools
+ * (list_docx_tools / run_docx_tool) and whole-document checkpoints. The editor
+ * side is mcp-agent-commands.ts in the docs app. Kept in their own file so
+ * document-tools.ts only carries one spread line.
+ */
+export function createDocxAgentTools(
+  target: ReturnType<typeof contentTarget>,
+  docs: NonNullable<DocToolDeps['docs']>,
+  documentField: z.ZodOptional<z.ZodString>,
+): McpToolDefinition[] {
+  return [
+    {
+      name: 'list_docx_tools',
+      description:
+        "List the Word editor's own document tools (name, description, JSON input schema) that " +
+        'run_docx_tool can call: revisions, comments, notes, headers/footers, page setup, styles, ' +
+        'tables, charts and the block edits. They are the tools the in-app assistant uses, so ' +
+        'their descriptions are written for an agent.',
+      inputSchema: { document: documentField },
+      handler: async (args) => {
+        const wc = await target(args.document)
+        return docs.runCommand(wc, 'list_tools', {})
+      },
+    },
+    {
+      name: 'run_docx_tool',
+      description:
+        "Run one of the Word editor's own document tools (see list_docx_tools) in the visible " +
+        'document, with the same executor, Track Changes attribution and stale-index guard as the ' +
+        'in-app assistant.',
+      inputSchema: {
+        tool: z.string().describe('tool name from list_docx_tools'),
+        input: z.record(z.string(), z.unknown()).optional().describe("the tool's input object"),
+        track: z
+          .boolean()
+          .optional()
+          .describe(
+            "record the edit as a tracked revision even while the document's Track Changes is off",
+          ),
+        author: z
+          .string()
+          .optional()
+          .describe(
+            'name the revisions and comments of this call are recorded under (default: the user name in Settings)',
+          ),
+        document: documentField,
+      },
+      handler: async (args) => {
+        const wc = await target(args.document)
+        return docs.runCommand(wc, 'run_tool', {
+          name: args.tool,
+          input: args.input ?? {},
+          ...(args.track === true ? { track: true } : {}),
+          ...(typeof args.author === 'string' ? { author: args.author } : {}),
+        })
+      },
+    },
+    {
+      name: 'save_checkpoint',
+      description:
+        'Remember the whole document under an id (for example before an agent turn) so ' +
+        'restore_checkpoint can undo everything done after it. The last 20 are kept per document.',
+      inputSchema: { id: z.string().describe('checkpoint id'), document: documentField },
+      handler: async (args) => {
+        const wc = await target(args.document)
+        return docs.runCommand(wc, 'save_checkpoint', { id: args.id })
+      },
+    },
+    {
+      name: 'restore_checkpoint',
+      description:
+        'Rewind the document to a checkpoint saved with save_checkpoint, as one undoable step. ' +
+        'Edits anyone made after it are rewound too; later checkpoints are dropped.',
+      inputSchema: { id: z.string().describe('checkpoint id'), document: documentField },
+      handler: async (args) => {
+        const wc = await target(args.document)
+        return docs.runCommand(wc, 'restore_checkpoint', { id: args.id })
+      },
+    },
+  ]
+}

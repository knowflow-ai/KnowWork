diff --git a/apps/sheets/src/shared/mcp-agent.ts b/apps/sheets/src/shared/mcp-agent.ts
new file mode 100644
index 00000000..699b89f0
--- /dev/null
+++ b/apps/sheets/src/shared/mcp-agent.ts
@@ -0,0 +1,13 @@
+/**
+ * Workbook commands of an external agent driving the open spreadsheet
+ * (KnowWork; handled by renderer/mcp-agent-commands.ts): the built-in
+ * assistant's own tools. Their own union so the MCP bridge routes them out
+ * before its switch over its own commands.
+ */
+export const SHEETS_AGENT_COMMANDS = ['list_tools', 'run_tool'] as const
+
+export type SheetsAgentCommand = (typeof SHEETS_AGENT_COMMANDS)[number]
+
+export function isSheetsAgentCommand(command: string): command is SheetsAgentCommand {
+  return (SHEETS_AGENT_COMMANDS as readonly string[]).includes(command)
+}

+import { describe, expect, it } from 'vitest'
+import { OP_GROUPS, opGuide } from '@genoffice/pptx-ops/op-docs'
+import { createSlidesGuideTools } from '../../src/main/mcp/tools/slides-guide-tools'
+
+const [tool] = createSlidesGuideTools()
+
+describe('slide_ops_guide', () => {
+  it('without groups: every op signature and the group catalog', async () => {
+    const { text } = (await tool!.handler({})) as { text: string }
+    expect(text).toContain('setText')
+    for (const group of OP_GROUPS) expect(text).toContain(group)
+  })
+
+  it('with groups: those groups in full, each once', async () => {
+    const { text } = (await tool!.handler({ groups: ['text', 'text', 'slide'] })) as { text: string }
+    expect(text).toBe([opGuide('text'), opGuide('slide')].join('\n\n---\n\n'))
+  })
+})
diff --git a/apps/shell/tests/web-open-documents.test.ts b/apps/shell/tests/web-open-documents.test.ts

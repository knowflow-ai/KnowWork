+++ b/apps/shell/src/main/mcp/tools/export-tools.ts
@@ -0,0 +1,60 @@
+import { isAbsolute } from 'node:path'
+import { z } from 'zod'
+import type { HeadlessExportFormat, HeadlessExportOutcome } from '@genoffice/electron-utils'
+import type { McpToolDefinition } from '../mcp-server'
+
+/**
+ * export_document: render a document to PDF (or HTML / Markdown / docx where
+ * the editor supports it) inside the running app.
+ *
+ * The same hidden-window exporters `--headless-export` drives, but without
+ * starting a second app per file: the CLI path cold-starts GenOffice for every
+ * export (5-8 s each on a Linux server, where the conversion itself is a
+ * fraction of that), which rules it out for a conversion service. Exports run
+ * one at a time, so a burst of requests cannot open a pile of hidden windows.
+ */
+
+export type ExportDocument = (request: {
+  input: string
+  targetFormat: HeadlessExportFormat
+  outPath: string
+}) => Promise<HeadlessExportOutcome>
+
+export function createExportTools(exportDocument: ExportDocument | undefined): McpToolDefinition[] {
+  if (!exportDocument) return []
+  let queue: Promise<unknown> = Promise.resolve()
+  return [
+    {
+      name: 'export_document',
+      description:
+        'Export a document file to another format with the editors themselves, in the running app ' +
+        '(no window, no second process): docx to pdf/html/md, xlsx and pptx to pdf, md to pdf, ' +
+        'html to pdf/docx. The file is read from disk, so save an open document first.',
+      inputSchema: {
+        input: z.string().describe('absolute path of the document to export'),
+        to: z.enum(['pdf', 'docx', 'html', 'md']).describe('target format'),
+        out: z.string().describe('absolute path to write'),
+      },
+      handler: async (args) => {
+        const input = String(args.input ?? '')
+        const out = String(args.out ?? '')
+        if (!isAbsolute(input) || !isAbsolute(out)) {
+          throw new Error('input and out must be absolute paths')
+        }
+        const run = queue.then(async () => {
+          const startedAt = Date.now()
+          const outcome = await exportDocument({
+            input,
+            targetFormat: args.to as HeadlessExportFormat,
+            outPath: out,
+          })
+          if (!outcome.ok) throw new Error(outcome.message)
+          return { ok: true, out: outcome.outPath, ms: Date.now() - startedAt }
+        })
+        // a failed export must not wedge the ones queued behind it
+        queue = run.catch(() => undefined)
+        return run
+      },
+    },
+  ]
+}

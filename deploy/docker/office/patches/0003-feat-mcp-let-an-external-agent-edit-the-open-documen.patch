diff --git a/apps/sheets/src/renderer/mcp-agent-commands.ts b/apps/sheets/src/renderer/mcp-agent-commands.ts
new file mode 100644
index 00000000..471cd5b3
--- /dev/null
+++ b/apps/sheets/src/renderer/mcp-agent-commands.ts
@@ -0,0 +1,87 @@
+import type { SheetsAgentCommand } from '../shared/mcp-agent'
+import { WORKBOOK_TOOLS, executeWorkbookTool, type SheetsSkillDeps } from './ai/tools'
+import { createWorkbookSkill } from './ai/workbook-skill'
+import { normalizeSheetRefs } from './mcp-sheet-refs'
+
+/**
+ * MCP commands for an external agent that works on the open workbook the way
+ * the in-app assistant does (KnowWork). Kept in its own file: the MCP bridge
+ * only forwards these commands here, so following upstream changes to
+ * mcp-bridge.ts stays a matter of one forwarding line.
+ *
+ * - list_tools: the assistant's workbook tools (context, range/cell/format
+ *   readers, search, aggregates, formula audit, guides, propose_operations)
+ *   plus its base prompt as `guide` — the workflow and op catalog those tools
+ *   are written against;
+ * - run_tool: one of them, with the same executor and stores the assistant
+ *   gets, so an applied batch lands in the undo history like an AI edit.
+ *
+ * Worksheets may be named (`sheet`, `sourceSheet`, `targetSheet`) wherever the
+ * tools take an id, the same name addressing the other MCP tools accept.
+ */
+
+/**
+ * Tools run_tool does not offer: create_document writes a new file into the
+ * default save folder and opens a tab, which an external agent does with its
+ * own file tools.
+ */
+const RUN_TOOL_EXCLUDED = new Set(['create_document'])
+
+/** the assistant's tool definitions an external agent may call through run_tool */
+export function externalWorkbookTools(): { name: string; description: string; inputSchema: unknown }[] {
+  return WORKBOOK_TOOLS.filter((tool) => !RUN_TOOL_EXCLUDED.has(tool.name)).map((tool) => ({
+    name: tool.name,
+    description: tool.description,
+    inputSchema: tool.inputSchema,
+  }))
+}
+
+/** a read tool's `sheet` (a name) resolved to the `sheetId` it takes */
+function withSheetId(
+  input: Record<string, unknown>,
+  deps: SheetsSkillDeps,
+): Record<string, unknown> {
+  if (typeof input.sheet !== 'string' || input.sheetId !== undefined) return input
+  const resolved = normalizeSheetRefs([input], deps.getActiveSheetInfo().sheets)
+  if (!resolved.ok) throw new Error(resolved.error)
+  return (resolved.ops[0] as Record<string, unknown> | undefined) ?? input
+}
+
+/** propose_operations' ops with worksheet names resolved to ids */
+function withOperationSheetIds(
+  input: Record<string, unknown>,
+  deps: SheetsSkillDeps,
+): Record<string, unknown> {
+  if (!Array.isArray(input.operations)) return input
+  const resolved = normalizeSheetRefs(input.operations, deps.getActiveSheetInfo().sheets)
+  if (!resolved.ok) throw new Error(resolved.error)
+  return { ...input, operations: resolved.ops }
+}
+
+/** handle an agent command (the bridge routes them here with isSheetsAgentCommand) */
+export async function runSheetsAgentCommand(
+  command: SheetsAgentCommand,
+  payload: unknown,
+  deps: SheetsSkillDeps,
+): Promise<unknown> {
+  switch (command) {
+    case 'list_tools':
+      return { tools: externalWorkbookTools(), guide: createWorkbookSkill(deps).systemPrompt }
+    case 'run_tool': {
+      const request = (payload ?? {}) as { name?: unknown; input?: unknown }
+      const name = typeof request.name === 'string' ? request.name : ''
+      if (!WORKBOOK_TOOLS.some((tool) => tool.name === name) || RUN_TOOL_EXCLUDED.has(name)) {
+        throw new Error(`run_tool cannot run "${name}"; list_tools gives the available tools`)
+      }
+      const raw =
+        request.input && typeof request.input === 'object'
+          ? { ...(request.input as Record<string, unknown>) }
+          : {}
+      const input =
+        name === 'propose_operations' ? withOperationSheetIds(raw, deps) : withSheetId(raw, deps)
+      const outcome = await executeWorkbookTool({ id: 'mcp', name, input }, deps)
+      if (outcome.isError) throw new Error(outcome.output)
+      return { summary: outcome.summary, output: outcome.output, mutated: outcome.mutated }
+    }
+  }
+}

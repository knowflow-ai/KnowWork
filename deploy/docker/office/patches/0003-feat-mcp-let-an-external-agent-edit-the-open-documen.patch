@@ -0,0 +1,17 @@
+/**
+ * Editor commands of an external agent driving the open document (KnowWork;
+ * handled by renderer/mcp-agent-commands.ts). Their own union so the MCP
+ * bridge routes them out before its exhaustive switch over its own commands.
+ */
+export const MCP_AGENT_COMMANDS = [
+  'list_tools',
+  'run_tool',
+  'save_checkpoint',
+  'restore_checkpoint',
+] as const
+
+export type McpAgentCommand = (typeof MCP_AGENT_COMMANDS)[number]
+
+export function isAgentCommand(command: string): command is McpAgentCommand {
+  return (MCP_AGENT_COMMANDS as readonly string[]).includes(command)
+}
diff --git a/apps/docs/tests/mcp-bridge-run-tool.test.ts b/apps/docs/tests/mcp-bridge-run-tool.test.ts
new file mode 100644
index 00000000..43fdd034
--- /dev/null
+++ b/apps/docs/tests/mcp-bridge-run-tool.test.ts
@@ -0,0 +1,248 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Editor } from '@tiptap/core'
+import { editorExtensions } from '../src/renderer/editor/extensions'
+import { installMcpBridge } from '../src/renderer/mcp-bridge'
+import type { McpEditorAccess } from '../src/renderer/mcp-agent-commands'
+import type { FileActionContext } from '../src/renderer/file-actions'
+import type { McpCommandMessage, McpCommandResult } from '../src/shared/ipc'
+
+/**
+ * The generic run_tool surface of the MCP bridge: an external agent gets the
+ * built-in assistant's document tools with the same stores (Track Changes
+ * author, comments, ...) the in-app agent passes, and decides when the yellow
+ * AI highlight goes away.
+ */
+
+interface JsonNode {
+  type: string
+  attrs?: Record<string, unknown>
+  content?: JsonNode[]
+  marks?: { type: string; attrs?: Record<string, unknown> }[]
+  text?: string
+}
+
+const para = (value: string): JsonNode => ({
+  type: 'docParagraph',
+  attrs: { docxIndex: null },
+  content: [{ type: 'text', text: value }],
+})
+
+const liveEditors: Editor[] = []
+
+function createEditor(content: JsonNode[]): Editor {
+  const editor = new Editor({
+    element: document.createElement('div'),
+    extensions: editorExtensions,
+    content: { type: 'doc', content },
+  })
+  liveEditors.push(editor)
+  return editor
+}
+
+afterEach(() => {
+  for (const editor of liveEditors.splice(0)) editor.destroy()
+})
+
+function install(editor: Editor, access?: McpEditorAccess) {
+  let handler: ((message: McpCommandMessage) => void) | undefined
+  let notify: ((result: McpCommandResult) => void) | undefined
+  window.desktop = {
+    onMcpCommand: (callback: (message: McpCommandMessage) => void) => {
+      handler = callback
+      return () => {
+        handler = undefined
+      }
+    },
+    reportMcpResult: (result: McpCommandResult) => notify?.(result),
+    signalMcpReady: () => {},
+  } as unknown as typeof window.desktop
+  const ctx = {
+    editor,
+    doc: { parsed: { blocks: [] }, isBlank: false },
+  } as unknown as FileActionContext
+  const uninstall = installMcpBridge({ getCtx: () => ctx, getAccess: () => access ?? null })
+  let seq = 0
+  const send = (command: McpCommandMessage['command'], payload: unknown) => {
+    const result = new Promise<McpCommandResult>((resolve) => {
+      notify = resolve
+    })
+    handler!({ requestId: `t-${++seq}`, command, payload })
+    return result
+  }
+  return { send, uninstall }
+}
+
+function insAuthors(node: JsonNode, out = new Set<string>()): Set<string> {
+  for (const mark of node.marks ?? []) {
+    if (mark.type === 'ins') out.add(String(mark.attrs?.author ?? ''))
+  }
+  for (const child of node.content ?? []) insAuthors(child, out)
+  return out
+}
+
+describe('MCP bridge list_tools', () => {
+  it('offers the document tools but not the ones that reach GenOffice’s own model or network', async () => {
+    const { send, uninstall } = install(createEditor([para('One')]))
+    try {
+      const result = await send('list_tools', {})
+      expect(result.ok).toBe(true)
+      const names = (result.result as { tools: { name: string }[] }).tools.map((t) => t.name)
+      expect(names).toEqual(
+        expect.arrayContaining(['replace_blocks', 'add_comment', 'accept_changes']),
+      )
+      for (const hidden of [
+        'web_search',
+        'generate_image',
+        'write_document',
+        'replace_selection',
+      ]) {
+        expect(names).not.toContain(hidden)
+      }
+    } finally {
+      uninstall()
+    }
+  })
+})
+
+describe('MCP bridge run_tool', () => {
+  it('runs a built-in tool and refuses excluded or unknown ones', async () => {
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor)
+    try {
+      await send('read_document', {})
+      const done = await send('run_tool', {
+        name: 'replace_blocks',
+        input: { startBlockIndex: 1, endBlockIndex: 1, html: '<p>Second</p>' },
+      })
+      expect(done.ok).toBe(true)
+      expect(editor.state.doc.child(1).textContent).toBe('Second')
+
+      const searched = await send('run_tool', { name: 'web_search', input: { query: 'x' } })
+      expect(searched.ok).toBe(false)
+      expect(searched.error).toContain('cannot run')
+      const unknown = await send('run_tool', { name: 'format_disk', input: {} })
+      expect(unknown.ok).toBe(false)
+    } finally {
+      uninstall()
+    }
+  })
+
+  it('records the edit as a revision by the given author while Track Changes is on', async () => {
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor, { track: { author: 'Zhang San (AI)' } })
+    try {
+      await send('read_document', {})
+      const done = await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 0, html: '<p>Inserted by the agent</p>' },
+      })
+      expect(done.ok).toBe(true)
+      expect([...insAuthors(editor.getJSON() as JsonNode)]).toEqual(['Zhang San (AI)'])
+    } finally {
+      uninstall()
+    }
+  })
+
+  it('records the revisions under the author a command names, then falls back', async () => {
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor, { track: { author: 'Zhang San' } })
+    try {
+      await send('read_document', {})
+      const named = await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 0, html: '<p>By the agent</p>' },
+        author: 'Zhang San (AI)',
+      })
+      expect(named.ok).toBe(true)
+      expect([...insAuthors(editor.getJSON() as JsonNode)]).toEqual(['Zhang San (AI)'])
+
+      await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 0, html: '<p>No author named</p>' },
+      })
+      // the scope ended with the command: the next one falls back to the Settings name
+      expect([...insAuthors(editor.getJSON() as JsonNode)].sort()).toEqual([
+        'Zhang San',
+        'Zhang San (AI)',
+      ])
+    } finally {
+      uninstall()
+    }
+  })
+
+  it('tracks an edit on request even while Track Changes is off', async () => {
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor)
+    try {
+      await send('read_document', {})
+      await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 0, html: '<p>Untracked</p>' },
+      })
+      expect([...insAuthors(editor.getJSON() as JsonNode)]).toEqual([])
+      await send('read_document', {})
+      const tracked = await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 0, html: '<p>Tracked</p>' },
+        track: true,
+        author: 'Zhang San (AI)',
+      })
+      expect(tracked.ok).toBe(true)
+      expect([...insAuthors(editor.getJSON() as JsonNode)]).toEqual(['Zhang San (AI)'])
+    } finally {
+      uninstall()
+    }
+  })
+
+  it('keeps a rollback point without copying the whole document', async () => {
+    // the agent saves one per document every turn: a full JSON copy of a long document,
+    // twenty kept, cost tens of MB in the tab and a pause each time; the document is
+    // immutable, so keeping it shares every unchanged node with the live one
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor)
+    const serialize = vi.spyOn(editor, 'getJSON')
+    try {
+      expect((await send('save_checkpoint', { id: 'turn-1' })).ok).toBe(true)
+      expect(serialize).not.toHaveBeenCalled()
+    } finally {
+      serialize.mockRestore()
+      uninstall()
+    }
+  })
+
+  it('rewinds a whole agent turn and drops the later points', async () => {
+    const editor = createEditor([para('One'), para('Two')])
+    const { send, uninstall } = install(editor)
+    try {
+      expect((await send('save_checkpoint', { id: 'turn-1' })).ok).toBe(true)
+      await send('read_document', {})
+      await send('run_tool', {
+        name: 'replace_blocks',
+        input: { startBlockIndex: 0, endBlockIndex: 0, html: '<p>Changed</p>' },
+      })
+      await send('save_checkpoint', { id: 'turn-2' })
+      await send('read_document', {})
+      await send('run_tool', {
+        name: 'insert_content',
+        input: { afterBlockIndex: 1, html: '<p>Added</p>' },
+      })
+      expect(editor.state.doc.childCount).toBe(3)
+
+      expect((await send('restore_checkpoint', { id: 'turn-1' })).ok).toBe(true)
+      expect(editor.state.doc.textContent).toBe('OneTwo')
+      const gone = await send('restore_checkpoint', { id: 'turn-2' })
+      expect(gone.ok).toBe(false)
+      expect(gone.error).toContain('no checkpoint')
+
+      // the rewound document is new to the agent: indexed writes wait for a re-read
+      const stale = await send('run_tool', {
+        name: 'replace_blocks',
+        input: { startBlockIndex: 0, endBlockIndex: 0, html: '<p>x</p>' },
+      })
+      expect(stale.ok).toBe(false)
+      expect((await send('save_checkpoint', {})).ok).toBe(false)
+    } finally {
+      uninstall()
+    }
+  })
+})

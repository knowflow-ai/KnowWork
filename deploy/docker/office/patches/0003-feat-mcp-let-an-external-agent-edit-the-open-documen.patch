+import { z } from 'zod'
+import { OP_GROUPS, opGuide, opGuideCatalog, opSignatureIndex } from '@genoffice/pptx-ops/op-docs'
+import type { McpToolDefinition } from '../mcp-server'
+
+/**
+ * The slide op reference for an external agent (KnowWork): what the in-app
+ * assistant's apply_ops description and load_guide tool carry, so a caller of
+ * apply_slide_ops learns each op's exact fields instead of guessing them from
+ * the op names. Same source as the assistant (packages/pptx-ops op-docs).
+ * Kept in its own file so slides-tools.ts only carries one spread line.
+ */
+export function createSlidesGuideTools(): McpToolDefinition[] {
+  return [
+    {
+      name: 'slide_ops_guide',
+      description:
+        'Reference for apply_slide_ops, the same one the in-app assistant uses. Without `groups`: ' +
+        "one signature line per op and the group catalog. With `groups`: those groups' field " +
+        'tables (types and units), runnable JSON examples and common mistakes — load the groups ' +
+        'of the ops a batch uses before sending it.',
+      inputSchema: {
+        groups: z
+          .array(z.enum(OP_GROUPS as [string, ...string[]]))
+          .optional()
+          .describe('op groups to load in full, e.g. ["text","element"]'),
+      },
+      handler: async (args) => {
+        const groups = Array.isArray(args.groups) ? [...new Set(args.groups.map(String))] : []
+        if (groups.length === 0) {
+          return { text: `${opSignatureIndex()}\n\nGroups:\n${opGuideCatalog()}` }
+        }
+        return { text: groups.map((group) => opGuide(group) ?? '').join('\n\n---\n\n') }
+      },
+    },
+  ]
+}

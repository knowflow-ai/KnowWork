+import { describe, expect, it } from 'vitest'
+import { createExportTools, type ExportDocument } from '../../src/main/mcp/tools/export-tools'
+
+describe('export_document', () => {
+  it('is only offered when the app can export in process', () => {
+    expect(createExportTools(undefined)).toEqual([])
+  })
+
+  it('runs exports one at a time and keeps going after a failure', async () => {
+    const order: string[] = []
+    let running = 0
+    const exportDocument: ExportDocument = async ({ input, outPath }) => {
+      running++
+      expect(running).toBe(1)
+      order.push(input)
+      await new Promise((resolve) => setTimeout(resolve, 5))
+      running--
+      if (input.endsWith('bad.docx')) return { ok: false, code: 3, message: 'conversion failed' }
+      return { ok: true, input, outPath }
+    }
+    const [tool] = createExportTools(exportDocument)
+    const results = await Promise.allSettled([
+      tool!.handler({ input: '/w/a.docx', to: 'pdf', out: '/w/a.pdf' }),
+      tool!.handler({ input: '/w/bad.docx', to: 'pdf', out: '/w/b.pdf' }),
+      tool!.handler({ input: '/w/c.pptx', to: 'pdf', out: '/w/c.pdf' }),
+    ])
+    expect(order).toEqual(['/w/a.docx', '/w/bad.docx', '/w/c.pptx'])
+    expect(results.map((r) => r.status)).toEqual(['fulfilled', 'rejected', 'fulfilled'])
+    expect((results[2] as PromiseFulfilledResult<{ out: string }>).value.out).toBe('/w/c.pdf')
+  })
+
+  it('wants absolute paths', async () => {
+    const [tool] = createExportTools(async () => ({ ok: true, input: '', outPath: '' }))
+    await expect(tool!.handler({ input: 'a.docx', to: 'pdf', out: '/w/a.pdf' })).rejects.toThrow(
+      'absolute',
+    )
+  })
+})

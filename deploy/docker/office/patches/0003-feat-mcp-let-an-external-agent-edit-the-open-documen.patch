@@ -0,0 +1,107 @@
+import { describe, expect, it } from 'vitest'
+import type { ActiveSheetInfo, SheetsSkillDeps } from '../src/renderer/ai/tools'
+import { runSheetsAgentCommand } from '../src/renderer/mcp-agent-commands'
+import { isSheetsAgentCommand } from '../src/shared/mcp-agent'
+
+function fakeDeps(overrides: Partial<SheetsSkillDeps> = {}): SheetsSkillDeps {
+  const info: ActiveSheetInfo = {
+    mode: 'demo',
+    sheetId: 'sheet-1',
+    sheetName: 'Sheet1',
+    revision: 0,
+    knownAddresses: ['A1'],
+    sheets: [
+      { id: 'sheet-1', name: 'Sheet1' },
+      { id: 'sheet-2', name: '明细' },
+    ],
+  }
+  return {
+    getActiveSheetInfo: () => info,
+    readCells: (addresses, sheetId) =>
+      Object.fromEntries(addresses.map((a) => [a, { value: `${sheetId ?? 'active'}:${a}` }])),
+    readFormats: () => ({}),
+    readSheetFeatures: () => '',
+    findCells: () => ({ matches: [], truncated: false, incompleteSheets: [] }),
+    selectRange: () => ({ ok: true, sheetName: 'Sheet1' }),
+    tracePrecedents: () => ({ refs: [] }),
+    traceDependents: () => ({ dependents: [], truncated: false, incompleteSheets: [] }),
+    proposeOperations: () => ({ ok: false, error: 'not configured' }),
+    ...overrides,
+  }
+}
+
+describe('sheets agent commands (external agent on the open workbook)', () => {
+  it('routes only its own commands', () => {
+    expect(isSheetsAgentCommand('list_tools')).toBe(true)
+    expect(isSheetsAgentCommand('run_tool')).toBe(true)
+    expect(isSheetsAgentCommand('apply_ops')).toBe(false)
+  })
+
+  it("lists the assistant's workbook tools without create_document, with its base prompt as the guide", async () => {
+    const listed = (await runSheetsAgentCommand('list_tools', {}, fakeDeps())) as {
+      tools: { name: string }[]
+      guide: string
+    }
+    const names = listed.tools.map((tool) => tool.name)
+    expect(names).toContain('propose_operations')
+    expect(names).toContain('read_range')
+    expect(names).toContain('load_guide')
+    expect(names).not.toContain('create_document')
+    expect(listed.guide).toContain('propose_operations')
+  })
+
+  it('resolves a worksheet name to its id for the readers', async () => {
+    const result = (await runSheetsAgentCommand(
+      'run_tool',
+      { name: 'read_cells', input: { addresses: ['B3'], sheet: '明细' } },
+      fakeDeps(),
+    )) as { output: string; mutated: boolean }
+    expect(result.output).toContain('sheet-2:B3')
+    expect(result.mutated).toBe(false)
+    await expect(
+      runSheetsAgentCommand('run_tool', { name: 'read_cells', input: { addresses: ['B3'], sheet: '没有' } }, fakeDeps()),
+    ).rejects.toThrow(/worksheet "没有"/)
+  })
+
+  it('resolves names inside propose_operations and reports the applied batch', async () => {
+    let seen: readonly unknown[] = []
+    const deps = fakeDeps({
+      proposeOperations: (operations) => {
+        seen = operations
+        return {
+          ok: true,
+          plan: {
+            transactionId: 't1',
+            baseRevision: 0,
+            cellChanges: [],
+            sheetRenames: [],
+            structuralChanges: [],
+            formatChanges: [],
+            warnings: [],
+          },
+          applied: Promise.resolve({ ok: true } as never),
+        }
+      },
+    })
+    const result = (await runSheetsAgentCommand(
+      'run_tool',
+      {
+        name: 'propose_operations',
+        input: { operations: [{ op: 'set_cell', sheet: '明细', address: 'B3', value: 1 }], summary: '写一格' },
+      },
+      deps,
+    )) as { mutated: boolean }
+    expect(seen).toEqual([expect.objectContaining({ op: 'set_cell', sheetId: 'sheet-2', address: 'B3' })])
+    expect(result.mutated).toBe(true)
+  })
+
+  it('refuses create_document and unknown tools, and surfaces tool errors', async () => {
+    await expect(runSheetsAgentCommand('run_tool', { name: 'create_document', input: {} }, fakeDeps())).rejects.toThrow(
+      /cannot run "create_document"/,
+    )
+    await expect(runSheetsAgentCommand('run_tool', { name: 'nope' }, fakeDeps())).rejects.toThrow(/cannot run "nope"/)
+    await expect(
+      runSheetsAgentCommand('run_tool', { name: 'read_range', input: { range: '' } }, fakeDeps()),
+    ).rejects.toThrow(/range must be a non-empty string/)
+  })
+})

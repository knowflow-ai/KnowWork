+import { webContents, type WebContents } from 'electron'
+import { webTabById } from '../../web/tab-registry'
+
+/**
+ * The renderer behind a webContents id, for the MCP bridges.
+ *
+ * In web-server mode an editor runs in a browser tab, and the WebTabContents
+ * standing in for it is not an Electron WebContents: `webContents.fromId`
+ * never finds it, so an MCP command for a browser tab would fail with "the
+ * document is no longer open" even while the user is looking at it. Browser
+ * tab ids start far above Electron's (see WebTabContents), so checking the
+ * web registry first cannot shadow a desktop view.
+ */
+export function contentsById(id: number): WebContents | undefined {
+  return webTabById(id)?.asWebContents() ?? webContents.fromId(id) ?? undefined
+}

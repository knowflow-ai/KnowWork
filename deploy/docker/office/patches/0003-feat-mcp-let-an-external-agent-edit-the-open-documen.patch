+import type { DocumentTabKind, OpenDocumentTab } from '../shared/tabs-api'
+import type { WebTabContents } from './web-contents'
+import { unregisterWebTab, webTabById, webTabs } from './tab-registry'
+
+/**
+ * Browser tabs as open documents (web-server mode).
+ *
+ * The MCP open-documents tools and the `document` target resolver list the
+ * tab manager's views and the detached windows. In web-server mode the
+ * editors the user is looking at are browser tabs, which are neither, so an
+ * agent could not find or edit them. This lists them in the same shape as
+ * TabManager.openDocuments, under ids that cannot collide with the others.
+ *
+ * The path is the one the tab was opened with (`?path=`): a Save As inside
+ * the browser tab does not update it.
+ */
+
+const ID_PREFIX = 'web:'
+const KINDS: readonly DocumentTabKind[] = ['docs', 'sheets', 'slides', 'pdf', 'markdown', 'html']
+
+interface WebTabDocument {
+  kind: DocumentTabKind
+  filePath?: string
+}
+
+function describe(tab: WebTabContents): WebTabDocument | null {
+  let url: URL
+  try {
+    url = new URL(tab.url, 'http://localhost')
+  } catch {
+    return null
+  }
+  const kind = url.pathname.split('/')[1] as DocumentTabKind
+  if (!KINDS.includes(kind)) return null
+  const filePath = url.searchParams.get('path') || undefined
+  return { kind, ...(filePath ? { filePath } : {}) }
+}
+
+/** unsaved-changes state, the same per-family checks the tab manager uses */
+async function webTabIsDirty(kind: DocumentTabKind, wc: WebContents): Promise<boolean> {
+  switch (kind) {
+    case 'sheets':
+      return sheetsPendingEditCount(wc.id) > 0
+    case 'docs':
+      return docsQueryDirty(wc)
+    case 'slides':
+      return slidesIsDirty(wc.id)
+    case 'pdf':
+      return pdfIsDirty(wc.id)
+    case 'markdown':
+      return markdownIsDirty(wc.id)
+    case 'html':
+      return htmlIsDirty(wc.id)
+    default:
+      return false
+  }
+}
+
+export function isWebTabId(id: string): boolean {
+  return id.startsWith(ID_PREFIX)
+}
+
+/** the browser tab's stand-in webContents for an id from webOpenDocuments */
+export function webTabContentsFor(id: string): WebContents | undefined {
+  if (!isWebTabId(id)) return undefined
+  const tab = webTabById(Number(id.slice(ID_PREFIX.length)))
+  return tab && !tab.isDestroyed() ? tab.asWebContents() : undefined
+}
+
+/**
+ * Close a browser tab's document from the server side (open_documents close).
+ * As for a closed desktop tab, Docs drops the crash-recovery copy and the
+ * renderer loses write access, so its 30s recovery loop cannot bring
+ * discarded edits back. The tab leaves the open-documents list and the page
+ * reloads itself, opening the file fresh from disk.
+ * False when the tab is already gone.
+ */
+export function closeWebTab(id: string): boolean {
+  if (!isWebTabId(id)) return false
+  const tab = webTabById(Number(id.slice(ID_PREFIX.length)))
+  if (!tab || tab.isDestroyed()) return false
+  if (describe(tab)?.kind === 'docs') teardownDocsRenderer(tab.asWebContents())
+  tab.deliver('web:closed', [])
+  unregisterWebTab(tab)
+  tab.destroy()
+  return true
+}
+
+export async function webOpenDocuments(): Promise<OpenDocumentTab[]> {
+  const out: OpenDocumentTab[] = []
+  for (const tab of webTabs()) {
+    if (tab.isDestroyed()) continue
+    const doc = describe(tab)
+    if (!doc) continue
+    out.push({
+      id: ID_PREFIX + tab.id,
+      kind: doc.kind,
+      title: doc.filePath ? basename(doc.filePath) : doc.kind,
+      ...(doc.filePath ? { filePath: doc.filePath } : {}),
+      // a browser tab's focus is not visible from here; none is "the" active one
+      active: false,
+      dirty: await webTabIsDirty(doc.kind, tab.asWebContents()),
+    })
+  }
+  return out
+}

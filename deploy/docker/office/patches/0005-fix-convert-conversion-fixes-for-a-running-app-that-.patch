+
+/// Excel's sheet limits: the walk below never runs past them
+const LAST_SHEET_ROW = 1_048_575
+const LAST_SHEET_COLUMN = 16_383
+
+/// The last row and column a visual reaches: its end marker, except for a visual
+/// anchored to one cell (oneCellAnchor), which keeps its size as offsets past that
+/// cell while its end marker stays on it (the engine encodes it so). That end is
+/// walked from the anchor through the rows and columns the visual covers; going by
+/// the end marker alone printed a tall flow chart beside a small table as a sliver
+/// on one page. A real end marker stays authoritative (pixel walks round).
+function visualEnd(
+  worksheet: PrintWorksheet,
+  visual: PrintVisual,
+): { row: number; column: number } {
+  if (!visual.sizedFromAnchor) return { row: visual.toRow, column: visual.toColumn }
+  const walk = (
+    start: number,
+    offsetPx: number,
+    spanPx: number,
+    sizeOf: (index: number) => number,
+    last: number,
+  ): number => {
+    let index = start
+    let remaining = finitePt(offsetPx, 0) + finitePt(spanPx, 0)
+    while (index < last && remaining > Math.max(sizeOf(index), 0)) {
+      remaining -= Math.max(sizeOf(index), 0)
+      index += 1
+    }
+    return index
+  }
+  return {
+    row: Math.max(
+      visual.toRow,
+      walk(
+        visual.fromRow,
+        visual.offsetYPx,
+        visual.heightPx,
+        (i) => worksheet.getRowHeight(i),
+        LAST_SHEET_ROW,
+      ),
+    ),
+    column: Math.max(
+      visual.toColumn,
+      walk(
+        visual.fromColumn,
+        visual.offsetXPx,
+        visual.widthPx,
+        (i) => worksheet.getColumnWidth(i),
+        LAST_SHEET_COLUMN,
+      ),
+    ),
   }
 }
 

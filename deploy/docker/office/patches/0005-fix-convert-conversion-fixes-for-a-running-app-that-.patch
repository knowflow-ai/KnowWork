@@ -0,0 +1,53 @@
+import JSZip from 'jszip'
+import { expect, it } from 'vitest'
+import { convertOdpToPptx } from '../src/index'
+
+// Text in an .odp mostly sits in shapes, not in text frames: LibreOffice saves a
+// PowerPoint text box as draw:custom-shape, and decks built by programs do the same.
+// Every shape was dropped, so such a deck converted to slides with no text at all.
+// A shape that holds text keeps it as a text box at the shape's place; its outline
+// and fill are reported as dropped. Shapes without text are dropped as before.
+const NS =
+  'xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" ' +
+  'xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" ' +
+  'xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" ' +
+  'xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"'
+
+async function odp(page: string): Promise<Uint8Array> {
+  const zip = new JSZip()
+  zip.file('mimetype', 'application/vnd.oasis.opendocument.presentation')
+  zip.file(
+    'content.xml',
+    `<office:document-content ${NS}><office:body><office:presentation><draw:page draw:name="P1">${page}</draw:page></office:presentation></office:body></office:document-content>`,
+  )
+  return zip.generateAsync({ type: 'uint8array' })
+}
+
+it('keeps the text of shapes as text boxes at their place', async () => {
+  const result = await convertOdpToPptx(
+    await odp(
+      '<draw:custom-shape svg:x="2cm" svg:y="3cm" svg:width="8cm" svg:height="2cm">' +
+        '<text:p>画完龙，再点上眼睛</text:p><draw:enhanced-geometry draw:type="rectangle"/></draw:custom-shape>' +
+        '<draw:rect svg:x="1cm" svg:y="6cm" svg:width="5cm" svg:height="1cm"><text:p>一笔点睛</text:p></draw:rect>' +
+        '<draw:line svg:x1="0cm" svg:y1="0cm" svg:x2="1cm" svg:y2="1cm"/>',
+    ),
+  )
+  const slide = await (
+    await JSZip.loadAsync(result.pptx)
+  )
+    .file('ppt/slides/slide1.xml')!
+    .async('string')
+  expect(slide).toContain('画完龙，再点上眼睛')
+  expect(slide).toContain('一笔点睛')
+  // 2cm, 3cm in EMU: the text box sits where the shape was
+  expect(slide).toContain('<a:off x="720000" y="1080000"/>')
+  expect(result.dropped.map((d) => d.what)).toContain('shape-styling')
+  expect(result.dropped.map((d) => d.what)).toContain('shapes')
+})
+
+it('still drops a shape without text', async () => {
+  const result = await convertOdpToPptx(
+    await odp('<draw:rect svg:x="1cm" svg:y="1cm" svg:width="5cm" svg:height="1cm"/>'),
+  )
+  expect(result.dropped.map((d) => d.what)).toEqual(['shapes'])
+})

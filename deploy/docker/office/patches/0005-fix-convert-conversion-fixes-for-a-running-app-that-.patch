@@ -0,0 +1,71 @@
+/**
+ * A running app exports a workbook for an external caller (MCP export_document)
+ * through a hidden sheets window the main process opens itself, handing it the
+ * output path. That path used to be honoured only in a --headless-export run, so
+ * the running app put up a save dialog instead — with no one to answer it in the
+ * web-server mode, the export "succeeded" with no file. A window the main process
+ * opened for an export writes where it was told; any other window still asks.
+ */
+import { existsSync, readFileSync } from 'node:fs'
+import { mkdtemp } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+  showSaveDialogWithMemory: vi.fn(async () => ({ canceled: true, filePath: undefined })),
+}))
+
+vi.mock('electron', () => {
+  class FakeBrowserWindow {
+    readonly webContents = { printToPDF: vi.fn(async () => Buffer.from('%PDF-1.4 workbook')) }
+    static fromWebContents(): null {
+      return null
+    }
+    async loadFile(): Promise<void> {}
+    destroy(): void {}
+  }
+  return { BrowserWindow: FakeBrowserWindow, dialog: {} }
+})
+vi.mock('@genoffice/electron-utils', () => ({
+  isHeadlessMode: () => false,
+  showSaveDialogWithMemory: mocks.showSaveDialogWithMemory,
+}))
+vi.mock('@genoffice/electron-utils/print-cups', () => ({
+  printPdfViaCups: vi.fn(),
+  printToPdfOptionsFor: vi.fn(),
+}))
+
+import { exportPdf } from '../src/main/pdf-export'
+
+const request = (outPath: string) => ({
+  fileName: 'book.pdf',
+  html: '<p>cells</p>',
+  landscape: false,
+  pageSize: 'A4' as const,
+  margins: { top: 0.5, bottom: 0.5, left: 0.5, right: 0.5 },
+  scale: 1,
+  outPath,
+})
+
+beforeEach(() => mocks.showSaveDialogWithMemory.mockClear())
+
+describe('exporting a workbook to PDF from a running app', () => {
+  it("writes an export window's file where the main process said, without a dialog", async () => {
+    const out = join(await mkdtemp(join(tmpdir(), 'sheets-own-export-')), 'book.pdf')
+    const result = await exportPdf({ sender: {} } as never, request(out), {
+      outPathAuthorized: true,
+    })
+    expect(result).toEqual({ canceled: false, path: out })
+    expect(readFileSync(out, 'utf8')).toBe('%PDF-1.4 workbook')
+    expect(mocks.showSaveDialogWithMemory).not.toHaveBeenCalled()
+  })
+
+  it('still asks where to save for any other window, whatever path its request names', async () => {
+    const out = join(await mkdtemp(join(tmpdir(), 'sheets-own-export-')), 'book.pdf')
+    const result = await exportPdf({ sender: {} } as never, request(out))
+    expect(mocks.showSaveDialogWithMemory).toHaveBeenCalledTimes(1)
+    expect(result).toEqual({ canceled: true })
+    expect(existsSync(out)).toBe(false)
+  })
+})

@@ -0,0 +1,121 @@
+/**
+ * Text that does not wrap spills into the empty cells next to it, as Excel prints it:
+ * left-aligned to the right, right-aligned to the left, centred evenly both ways, up to
+ * the first cell with content. The exported PDF used to clip every cell at its own edge,
+ * so a note typed into one cell of a wide empty row came out cut off after a few words.
+ * Numbers never spill (Excel shows ####), nor does wrapped text.
+ */
+import { describe, expect, it } from 'vitest'
+import { layoutSheetPrint, type PrintWorksheet } from '../src/renderer/print-html'
+import type { EffectivePageSetup } from '../src/renderer/print-settings'
+
+type Cell = string | number
+const LONG = '本表为演示生成的示例数据，销量、单价、成本均非真实业务数据'
+const grid: Cell[][] = [
+  [LONG, '', '', 'D1'],
+  [LONG, 'B2', '', ''],
+  ['', '', LONG, ''],
+  [1234567890123, '', '', ''],
+  [LONG, '', '', ''],
+  ['', LONG, '', ''],
+]
+const styles: Record<string, object> = {
+  '2:2': { ht: 3 },
+  '4:0': { tb: 3 },
+  '5:1': { ht: 2 },
+}
+
+function worksheet(): PrintWorksheet {
+  const slice = (row: number, column: number, rows = 1, columns = 1) =>
+    grid.slice(row, row + rows).map((cells) => cells.slice(column, column + columns))
+  return {
+    getLastRow: () => grid.length - 1,
+    getLastColumn: () => 3,
+    getRowHeight: () => 20,
+    getColumnWidth: () => 100,
+    getMergedRanges: () => [],
+    getRange: ((row: number, column: number, rows?: number, columns?: number) => ({
+      getDisplayValues: () => slice(row, column, rows, columns).map((r) => r.map(String)),
+      getValues: () => slice(row, column, rows, columns),
+      getCellStyleData: () => styles[`${row}:${column}`] ?? null,
+    })) as PrintWorksheet['getRange'],
+  }
+}
+
+const setup = {
+  orientation: 'landscape',
+  paperSize: 9,
+  scale: 100,
+  fitToWidth: 0,
+  fitToHeight: 0,
+  fitToPage: false,
+  margins: { left: 0.7, right: 0.7, top: 0.75, bottom: 0.75, header: 0.3, footer: 0.3 },
+  printGridlines: false,
+  printHeadings: false,
+  printAreas: [],
+  printTitles: null,
+  printTitleColumns: null,
+  header: null,
+  footer: null,
+  firstPage: null,
+  evenPages: null,
+  headerFooterScaleWithDoc: true,
+  headerFooterPictures: [],
+} as EffectivePageSetup
+
+const body = (): string =>
+  layoutSheetPrint(
+    worksheet(),
+    setup,
+    'Book',
+    'S1',
+    new Map(),
+    { visuals: [], css: '' },
+    {
+      now: new Date(2026, 0, 2),
+    },
+  ).pages[0]!.body
+
+/** the cell holding `text` in row `row` (0-based, body rows in order): its td and content box styles */
+function cellStyles(html: string, row: number, text: string): { td: string; box: string } {
+  const rows = html.match(/<tr\b[^>]*>.*?<\/tr>/gs) ?? []
+  const match = new RegExp(
+    `<td[^>]*style="([^"]*)"[^>]*><div class="c" style="([^"]*)"><span>${text}</span>`,
+  ).exec(rows[row] ?? '')
+  if (!match) throw new Error(`no cell "${text}" in row ${row}`)
+  return { td: match[1]!, box: match[2]! }
+}
+
+describe('text spilling into empty neighbours in the printed sheet', () => {
+  const html = body()
+  const column = Number(/<col style="width:([\d.]+)pt">/.exec(html)?.[1])
+
+  it('left-aligned text spills right up to the first cell with content', () => {
+    const { td, box } = cellStyles(html, 0, LONG)
+    expect(td).toContain('overflow:visible')
+    expect(box).toContain(`width:calc(100% + ${2 * column}pt)`)
+    expect(box).not.toContain('margin-left')
+  })
+
+  it('stays in its cell when the neighbour has content', () => {
+    expect(cellStyles(html, 1, LONG).td).not.toContain('overflow:visible')
+  })
+
+  it('right-aligned text spills left', () => {
+    const { td, box } = cellStyles(html, 2, LONG)
+    expect(td).toContain('overflow:visible')
+    expect(box).toContain(`margin-left:-${2 * column}pt`)
+    expect(box).toContain(`width:calc(100% + ${2 * column}pt)`)
+  })
+
+  it('centred text spills evenly both ways so it stays centred on its cell', () => {
+    const { box } = cellStyles(html, 5, LONG)
+    expect(box).toContain(`margin-left:-${column}pt`)
+    expect(box).toContain(`width:calc(100% + ${2 * column}pt)`)
+  })
+
+  it('numbers and wrapped text never spill', () => {
+    expect(cellStyles(html, 3, '1234567890123').td).not.toContain('overflow:visible')
+    expect(cellStyles(html, 4, LONG).td).not.toContain('overflow:visible')
+  })
+})

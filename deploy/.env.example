# KnowWork 部署配置。复制为 deploy/.env 后按需修改；install.sh 首次运行会自动复制并填好随机凭证。
# 所有项都有默认值，留空即用默认。部署主密钥、宿主令牌、数据库口令由 bootstrap 自动生成，不在这里配置。

# 编排文件：默认带上会话沙箱（docker-compose.sandbox.yml，挂本机 docker.sock）。
# 不要沙箱时只留 docker-compose.yml（install.sh --no-sandbox 会替你改）；这时模型不能执行命令，也生成不了 Word、Excel。
COMPOSE_FILE=docker-compose.yml:docker-compose.sandbox.yml

# ---- 镜像 ----
# 阿里云容器镜像服务的地址与命名空间；postgres、redis、rustfs 也从这里拉（照原样同步的副本）
KNOWWORK_REGISTRY=crpi-6q638zy09wmnj70w.cn-hangzhou.personal.cr.aliyuncs.com/knowflow-ai
KNOWWORK_VERSION=v0.0.1
# missing：本地没有才拉；always：每次启动都拉；never：只用本地镜像（离线部署）
KNOWWORK_PULL_POLICY=missing
# 要换成别处的 postgres、redis、rustfs 镜像时填完整地址，留空用上面仓库里的副本
KNOWWORK_POSTGRES_IMAGE=
KNOWWORK_REDIS_IMAGE=
KNOWWORK_RUSTFS_IMAGE=

# ---- 访问入口 ----
KNOWWORK_BIND_ADDRESS=0.0.0.0
KNOWWORK_PORT=8080
# 浏览器访问的外部地址：邀请链接与 OIDC 回调据此拼出，改端口或配域名时同步改。
# install.sh 首次运行时会换成本机的 IP 地址
KNOWWORK_PUBLIC_BASE_URL=http://localhost:8080
# 会话 Cookie 是否只走 HTTPS。默认按 http 访问设为 false，否则浏览器不收 Cookie、登录不了；
# 在网关前配好 HTTPS（PUBLIC_BASE_URL 改成 https://）后改成 true
KNOWWORK_COOKIE_SECURE=false

# ---- 单点登录（OIDC）。issuer 留空即不启用 ----
KNOWWORK_OIDC_ISSUER=
KNOWWORK_OIDC_CLIENT_ID=
KNOWWORK_OIDC_CLIENT_SECRET=
KNOWWORK_OIDC_REDIRECT_URI=

# ---- 模型 ----
# 模型在管理界面的模型目录里配置；下面的固定上游是可选的兜底，留空即不用
KNOWWORK_MODEL_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
KNOWWORK_MODEL_UPSTREAM_API_KEY=
KNOWWORK_MODEL_UPSTREAM_MODEL=deepseek-chat
# 宿主向模型网关请求时用的模型名（api 与宿主共用）
KNOWWORK_HOST_MODEL_ALIAS=default
KNOWWORK_MODEL_CONTEXT_WINDOW=131072
# 宿主调用模型网关的短期令牌有效期（秒，60–3600），业务服务自动轮换
KNOWWORK_MODEL_TOKEN_TTL_SECONDS=900

# ---- 外部服务 ----
# MinerU 文档解析服务地址；留空时附件解析会明确提示未配置
KNOWWORK_MINERU_BASE_URL=

# ---- 会话沙箱（Docker 后端，做法同 WeKnora）----
# 本机沙箱的开关是上面的 COMPOSE_FILE。能创建容器就等于能控制这个 Docker daemon，本机 docker.sock 等同宿主机 root，
# 仅私有化单机使用。连远端 daemon 时去掉 docker-compose.sandbox.yml，打开下面的开关并填地址与证书：
# KNOWWORK_SANDBOX_DOCKER_ENABLED=true
# 沙箱镜像；留空用 ${KNOWWORK_REGISTRY}/knowwork-sandbox:${KNOWWORK_VERSION}
KNOWWORK_SANDBOX_IMAGE=
# daemon 地址：留空用 DOCKER_HOST 或本机套接字；远端填 tcp://主机:2376，必须同时配 TLS 证书目录（ca.pem、cert.pem、key.pem）
KNOWWORK_SANDBOX_DOCKER_HOST=
KNOWWORK_SANDBOX_DOCKER_TLS_CERT_PATH=
# 沙箱能否出网：true 用 bridge 网络，false 用 none（完全断网）
KNOWWORK_SANDBOX_ALLOW_INTERNET=true
# 可选的 OCI runtime（daemon 已安装的，如 runsc）；留空用 daemon 默认
KNOWWORK_SANDBOX_RUNTIME=

# ---- 对象存储（RustFS）。留空时 install.sh 生成随机值写回本文件 ----
KNOWWORK_RUSTFS_ACCESS_KEY=
KNOWWORK_RUSTFS_SECRET_KEY=
KNOWWORK_S3_BUCKET=knowwork

# ---- 运行参数 ----
KNOWWORK_APPROVAL_TIMEOUT_MS=1800000
KNOWWORK_QUESTION_TIMEOUT_MS=1800000
KNOWWORK_REDIS_MAXMEMORY=256mb
KNOWWORK_LOG_LEVEL=info
TZ=Asia/Shanghai

# ---- 网络与卷 ----
# api 与宿主之间的内部网段；与宿主机已有网段冲突时改这两项（IP 必须在网段内）
KNOWWORK_HOST_LINK_SUBNET=172.30.240.0/24
KNOWWORK_API_HOST_LINK_IP=172.30.240.10
# 打开本机沙箱时 api 挂载的 Docker 套接字路径
KNOWWORK_DOCKER_SOCKET=/var/run/docker.sock
KNOWWORK_VOLUME_PREFIX=knowwork

# ---- install.sh ----
# 等待 /ready 的最长秒数
KNOWWORK_READY_TIMEOUT=300
